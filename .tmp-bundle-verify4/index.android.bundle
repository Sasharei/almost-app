642\u064b\u0627 \u0639\u0646\u062f\u0645\u0627 \u062a\u0634\u0639\u0631 \u0628\u0627\u0644\u062c\u0648\u0639.",tamagotchiEarnCoinsHint:"\u0627\u0631\u0628\u062d \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u062f\u0646\u064a\u0629 \u0639\u0628\u0631 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062d\u0641\u0638 \u0648\u0627\u0644\u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0648\u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a.",tamagotchiNeedCoinsMessage:"\u0623\u0646\u062a \u0628\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0639\u0645\u0644\u0627\u062a \u0645\u0639\u062f\u0646\u064a\u0629 {{cost}} \u200b\u200b\u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0644\u0640 {{emoji}}.",tamagotchiMissYouNotificationTitle:"Almi \u200b\u200b\u0627\u0634\u062a\u0642\u062a\u0644\u0643 \ud83d\ude3f",tamagotchiMissYouNotificationBody:"\u0644\u0642\u062f \u0643\u0646\u062a \u0628\u0639\u064a\u062f\u0627 \u0644\u0623\u0643\u062b\u0631 \u0645\u0646 20 \u0633\u0627\u0639\u0629. Almi \u200b\u200b\u064a\u0634\u0639\u0631 \u0628\u0627\u0644\u062d\u0632\u0646 \u0648\u064a\u0646\u062a\u0638\u0631\u0643.",tamagotchiPartyNeedCoinsMessage:"\u0623\u0646\u062a \u0628\u062d\u0627\u062c\u0629 \u0625\u0644\u0649 \u0639\u0645\u0644\u0627\u062a \u0645\u0639\u062f\u0646\u064a\u0629 \u0632\u0631\u0642\u0627\u0621 {{amount}} \u200b\u200b\u0644\u0628\u062f\u0621 \u0627\u0644\u062d\u0641\u0644\u0629.",tamagotchiPartyButtonLabel:"\u0627\u0644\u062d\u0641\u0644\u0629 \xd7{{cost}}",tamagotchiImmunityHintTitle:"\u0627\u0644\u062d\u0635\u0627\u0646\u0629",tamagotchiImmunityActiveLabel:"\u0645\u0646\u0627\u0639\u0629 \u0627\u0644\u062c\u0648\u0639 \u0646\u0634\u0637\u0629",tamagotchiImmunityTimeLeftLabel:"\u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u062a\u0628\u0642\u064a: {{time}}",tamagotchiFullHint:"\u0625\u0646\u0647 \u0645\u0645\u062a\u0644\u0626\u060c \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0644\u0627\u062d\u0642\u0627\u064b.",tamagotchiSpeechGreetingFirst:["\u0623\u0647\u0644\u0627\u064b! \u0623\u0646\u0627 Almi.","\u0645\u0647\u0644\u0627\u060c \u0644\u0642\u062f \u0641\u0639\u0644\u062a \u0630\u0644\u0643. \u0623\u0646\u0627 Almi.","\u0623\u0647\u0644\u0627\u064b! \u0639\u0644\u0649 \u0627\u0633\u062a\u0639\u062f\u0627\u062f \u0644\u0644\u062d\u0641\u0638 \u0645\u0639\u0627\u061f","\u0633\u0639\u064a\u062f \u0628\u0644\u0642\u0627\u0626\u0643. \u0623\u0646\u0627 Almi.","\u0645\u0631\u062d\u0628\u064b\u0627 \u064a\u0627 \u0645\u0646 \u0647\u0646\u0627\u0643! \u0644\u0646\u0628\u062f\u0623."],tamagotchiSpeechGreetingSoon:["\u0627\u0644\u0639\u0648\u062f\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649\u061f \u0644\u0637\u064a\u0641 - \u062c\u064a\u062f.","\u0628\u0627\u0644\u0641\u0639\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649\u061f \u0623\u062d\u0628\u0647\u0627.","\u0623\u0646\u062a \u0645\u0631\u0629 \u0623\u062e\u0631\u0649! \u062c\u064a\u062f.","\u0639\u0648\u062f\u0629 \u0633\u0631\u064a\u0639\u0629. \u0623\u0646\u0627 \u0647\u0646\u0627.","\u0627\u0644\u0639\u0648\u062f\u0629 \u0628\u0639\u062f {{minutes}}m\u061f \u0644\u0637\u064a\u0641 - \u062c\u064a\u062f."],tamagotchiSpeechGreeting:["\u0645\u0631\u062d\u0628\u064b\u0627 \u0628\u0639\u0648\u062f\u062a\u0643!","\u064a\u0627! \u0645\u0646 \u0627\u0644\u062c\u064a\u062f \u0631\u0624\u064a\u062a\u0643.","\u0645\u0631\u062d\u0628\u0627 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.","\u0633\u0639\u064a\u062f \u0644\u0623\u0646\u0643 \u0647\u0646\u0627.","\u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u0635\u062d\u064a\u062d."],tamagotchiSpeechGreetingHungry:["\u0623\u0647\u0644\u0627\u064b! \u0623\u0646\u0627 \u062c\u0627\u0626\u0639\u060c {{food}}\u061f","\u0644\u0642\u062f \u0639\u062f\u062a! \u0647\u0644 \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 {{food}}\u061f","\u0627\u0634\u062a\u0642\u062a \u0644\u0643 \u0648\u0623\u0646\u0627 \u062c\u0627\u0626\u0639. {{food}}\u061f","\u0645\u0631\u062d\u0628\u064b\u0627 \u0628\u0639\u0648\u062f\u062a\u0643. \u0623\u0637\u0639\u0645\u0646\u064a {{food}}\u061f","\u064a\u0627! \u0648\u0642\u062a \u0627\u0644\u0648\u062c\u0628\u0629 \u0627\u0644\u062e\u0641\u064a\u0641\u0629\u061f {{food}}\u061f"],tamagotchiSpeechMissed:["\u0627\u0634\u062a\u0642\u062a \u0644\u0643. \u0633\u0639\u064a\u062f \u0628\u0639\u0648\u062f\u062a\u0643.","\u0647\u0627 \u0623\u0646\u062a \u0630\u0627. \u0627\u0634\u062a\u0642\u062a \u0644\u0643.","\u0644\u0642\u062f \u0639\u062f\u062a. \u0644\u0637\u064a\u0641 - \u062c\u064a\u062f.","\u0643\u0646\u062a \u0623\u0646\u062a\u0638\u0631.","\u0645\u0631\u062d\u0628\u064b\u0627 \u0628\u0639\u0648\u062f\u062a\u0643."],tamagotchiSpeechMissedHungry:["\u0627\u0634\u062a\u0642\u062a \u0644\u0643 \u0648\u0623\u0646\u0627 \u062c\u0627\u0626\u0639. {{food}}\u061f","\u0623\u064a\u0646 \u0643\u0646\u062a\u061f \u0623\u0646\u0627 \u062c\u0627\u0626\u0639.","\u0627\u0646\u062a\u0638\u0631\u062a. \u0623\u0646\u0627 \u062c\u0627\u0626\u0639.","\u0627\u0634\u062a\u0642\u062a \u0644\u0643. \u0623\u0637\u0639\u0645\u0646\u064a\u061f"],tamagotchiSpeechHungry:["\u0623\u0646\u0627 \u062c\u0627\u0626\u0639. {{food}}\u061f","\u0642\u0631\u0642\u0631\u0629 \u0627\u0644\u0628\u0637\u0646. \u0648\u062c\u0628\u0629 \u062e\u0641\u064a\u0641\u0629\u061f","\u0623\u0631\u064a\u062f {{food}}.","\u0623\u0637\u0639\u0645\u0646\u064a\u061f"],tamagotchiSpeechHungrySoft:["\u062c\u0627\u0626\u0639 \u0642\u0644\u064a\u0644\u0627.","\u0647\u0644 \u064a\u0645\u0643\u0646\u0646\u064a \u062a\u0646\u0627\u0648\u0644 \u0648\u062c\u0628\u0629 \u062e\u0641\u064a\u0641\u0629\u061f","\u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0644\u062f\u063a\u0629.","{{food}} \u200b\u200b\u0633\u064a\u0643\u0648\u0646 \u0644\u0637\u064a\u0641\u064b\u0627."],tamagotchiSpeechFed:["\u062e\u0631\u062e\u0631\u0629\u060c \u0644\u0630\u064a\u0630!","\u0634\u0643\u0631\u0627 \u0639\u0644\u0649 {{food}}!","\u0627\u0644\u0627\u0645\u062a\u0644\u0627\u0621 +1. \u0645\u0648\u0627\u0621.","\u0627\u0644\u062a\u064a \u0636\u0631\u0628\u062a \u0627\u0644\u0645\u0643\u0627\u0646.","\u0627\u0644\u0633\u064a\u062f\u060c \u0634\u0643\u0631\u0627!"],tamagotchiSpeechNeedPlay:["\u0623\u0646\u0627 \u0623\u0634\u0639\u0631 \u0628\u0627\u0644\u0645\u0644\u0644. \u0647\u0644 \u064a\u0645\u0643\u0646\u0646\u0627 \u0627\u0644\u0644\u0639\u0628 {{toy}}\u061f","\u0623\u0631\u064a\u062f \u0623\u0646 \u0623\u0644\u0639\u0628. \u062f\u0639\u0646\u0627 \u0646\u0630\u0647\u0628 \u0645\u0639 {{toy}}!","\u0623\u0646\u0627 \u062d\u0632\u064a\u0646 \u0628\u062f\u0648\u0646 \u0623\u0644\u0639\u0627\u0628. \u0623\u062d\u0636\u0631 {{toy}}\u061f","\u062a\u0644\u0639\u0628 \u0645\u0639\u064a\u061f \u0623\u0646\u0627 \u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 {{toy}}."],tamagotchiSpeechNeedClean:["\u0623\u0646\u0627 \u0642\u0630\u0631. \u0648\u0642\u062a \u0627\u0644\u0627\u0633\u062a\u062d\u0645\u0627\u0645 \u0645\u0646 \u0641\u0636\u0644\u0643.","\u0647\u0644 \u064a\u0645\u0643\u0646\u0643 \u062a\u0646\u0638\u064a\u0641\u064a\u061f \u0623\u0646\u0627 \u0645\u063a\u0628\u0631.","\u0623\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0635\u0627\u0628\u0648\u0646 \u0648\u0641\u0631\u0634\u0627\u0629.","\u064a\u0631\u062c\u0649 \u062a\u0646\u0638\u064a\u0641 \u0627\u0644\u0641\u0631\u0627\u0621 \u0628\u0644\u062f\u064a."],tamagotchiSpeechPlayed:["{{toy}} \u200b\u200b\u0643\u0627\u0646 \u0631\u0627\u0626\u0639\u064b\u0627!","\u0634\u0643\u0631\u0627 \u0644\u0644\u0639\u0628 \u0645\u0639\u064a!","\u0643\u0627\u0646 \u0630\u0644\u0643 \u0645\u0645\u062a\u0639\u0627\u064b. \u062f\u0639\u0648\u0646\u0627 \u0646\u0641\u0639\u0644 \u0630\u0644\u0643 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0641\u064a \u0648\u0642\u062a \u0644\u0627\u062d\u0642.","\u062e\u0631\u062e\u0631\u0629! \u0627\u0644\u0644\u0639\u0628 \u0635\u0646\u0639 \u064a\u0648\u0645\u064a."],tamagotchiSpeechCleaned:["\u0634\u0643\u0631\u0627\u060c \u0623\u0646\u0627 \u0646\u0638\u064a\u0641 \u0648\u0631\u0642\u064a\u0642 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649!","\u0627\u0644\u0633\u064a\u062f\u060c \u0627\u0644\u0630\u064a \u0634\u0639\u0631\u062a \u0628\u0627\u0644\u0627\u0631\u062a\u064a\u0627\u062d.","\u0627\u0644\u0641\u0631\u0627\u0621 \u0628\u0644\u062f\u064a \u064a\u0636\u064a\u0621 \u0627\u0644\u0622\u0646. \u0634\u0643\u0631\u064b\u0627 \u0644\u0643!","\u0623\u0641\u0636\u0644 \u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0644\u0629 \u0639\u0644\u0649 \u0627\u0644\u0625\u0637\u0644\u0627\u0642. \u0634\u0643\u0631\u064b\u0627!"],tamagotchiSpeechPraiseSaveYesterday:["\u0644\u0642\u062f \u062a\u062e\u0637\u064a\u062a \"{{title}}\" \u0628\u0627\u0644\u0623\u0645\u0633.","\u0641\u0648\u0632 \u0627\u0644\u0623\u0645\u0633: \"{{title}}\".","\u0644\u0637\u064a\u0641\u0629 \u0645\u0639 \"{{title}}\"."],tamagotchiSpeechPraiseSaveRecent:["\u062d\u0641\u0638 \u0631\u0627\u0626\u0639: \"{{title}}\".","\u0644\u0637\u064a\u0641 - \u062c\u064a\u062f! \u062a\u0645 \u062a\u062e\u0637\u064a \"{{title}}\".","\u0627\u0644\u0641\u0648\u0632: \"{{title}}\"."],tamagotchiSpeechSaveWin:["\u064a\u0641\u0648\u0632! \u062d\u0641\u0638 \u0639\u0638\u064a\u0645.","\u0627\u0646\u062a\u0635\u0627\u0631 \u0622\u062e\u0631!","\u0639\u0642\u062f \u062c\u0645\u064a\u0644. \u0644\u0642\u062f \u0641\u0639\u0644\u062a \u0630\u0644\u0643.","\u0645\u0643\u0627\u0644\u0645\u0629 \u0642\u0648\u064a\u0629.","\u0641\u0648\u0632 \u0643\u0628\u064a\u0631."],tamagotchiSpeechTrollSpendYesterday1:"\u0623\u0645\u0633: \"{{title}}\". \u0631\u0623\u064a\u062a \u0630\u0644\u0643.",tamagotchiSpeechTrollSpendYesterday2:"\u0644\u0642\u062f \u0627\u0633\u062a\u0633\u0644\u0645\u062a \u0644\u0640 \"{{title}}\" \u0628\u0627\u0644\u0623\u0645\u0633.",tamagotchiSpeechTrollSpendYesterday3:"\u0628\u0627\u0644\u0623\u0645\u0633 \"{{title}}\". \u0630\u064f\u0643\u0631.",tamagotchiSpeechTrollSpendRecent1:"\u0622\u062e\u0631 \"{{title}}\". \u0631\u0623\u064a\u062a.",tamagotchiSpeechTrollSpendRecent2:"\"{{title}}\" \u0645\u0631\u0629 \u0623\u062e\u0631\u0649. \u0623\u0631\u0649.",tamagotchiSpeechTrollSpendRecent3:"\"{{title}}\" \u0645\u0631\u0629 \u0623\u062e\u0631\u0649\u061f \u0644\u0642\u062f \u0644\u0627\u062d\u0638\u062a.",tamagotchiSpeechSpendRegret:["\u0623\u0648\u0647\u060c \"{{title}}\" \u062d\u062f\u062b. \u0646\u062d\u0646 \u0646\u0645\u0636\u064a \u0642\u062f\u0645\u0627.","\"{{title}}\" \u062d\u0635\u0644\u062a \u0639\u0644\u064a\u0643 \u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u0629. \u0627\u0644\u0641\u0648\u0632 \u0627\u0644\u0642\u0627\u062f\u0645 \u0642\u0631\u064a\u0628\u0627.","\u064a\u062d\u062f\u062b \u0630\u0644\u0643. \"{{title}}\" \u0644\u0646 \u064a\u0643\u0633\u0631 \u0627\u0644\u062e\u0637.","\u062d\u0633\u0646\u064b\u0627\u060c \"{{title}}\" - \u0627\u0644\u062e\u064a\u0627\u0631 \u0627\u0644\u062a\u0627\u0644\u064a \u0644\u0646\u0627.","\u0644\u0627\u062d\u0638: \"{{title}}\". \u0633\u0648\u0641 \u0646\u0631\u062a\u062f \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],tamagotchiSpeechSpendRegretGeneric:["\u064a\u062d\u062f\u062b \u0630\u0644\u0643. \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u062a\u0627\u0644\u064a \u0645\u0647\u0645.","\u0644\u0627 \u0627\u0644\u0644\u0648\u0645. \u064a\u0633\u062a\u0645\u0631 \u0641\u064a \u0627\u0644\u062a\u0642\u062f\u0645.","\u062a\u0645\u0627\u0645. \u0633\u0648\u0641 \u0646\u0631\u062a\u062f \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.","\u0644\u064a\u0633\u062a \u0645\u062b\u0627\u0644\u064a\u0629\u060c \u0648\u0644\u0643\u0646\u0646\u0627 \u0646\u0633\u062a\u0645\u0631.","\u0623\u0646\u0627 \u0647\u0646\u0627. \u0641\u0635\u0627\u0639\u062f\u0627."],tamagotchiSpeechGoalComplete:["\u0627\u0644\u0647\u062f\u0641 \u0643\u0627\u0645\u0644! \u0645\u0627 \u0647\u064a \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u061f","\u0644\u0642\u062f \u0646\u062c\u062d\u062a \u0641\u064a \u0630\u0644\u0643. \u062d\u0644\u0645 \u062c\u062f\u064a\u062f\u061f","\u0645\u0646\u062a\u0647\u064a! \u0647\u062f\u0641 \u062c\u062f\u064a\u062f\u061f"],tamagotchiSpeechGoalProgress:["{{amount}} \u200b\u200b\u0625\u0644\u0649 \u0627\u0644\u0647\u062f\u0641.","Almost \u0647\u0646\u0627\u0643: {{amount}}.","\u064a\u063a\u0644\u0642. {{amount}} \u200b\u200b\u0627\u0644\u064a\u0633\u0627\u0631."],tamagotchiSpeechChallengeProgress:["\u0627\u0644\u062a\u062d\u062f\u064a \"{{title}}\": {{progress}}.","\u0627\u0644\u062a\u0642\u062f\u0645 \u0641\u064a \"{{title}}\": {{progress}}.","\"{{title}}\" \u0645\u0648\u062c\u0648\u062f \u0641\u064a {{progress}}.","\u062a\u062d\u062f\u064a \u0627\u0644\u062a\u062d\u0631\u0643: {{progress}}.","\u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0641\u064a \"{{title}}\": {{progress}}."],tamagotchiSpeechLevelProgress:["{{amount}} \u200b\u200b\u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u0627\u0644\u064a.","\u0641\u0642\u0637 {{amount}} \u200b\u200b\u0644\u0644\u0645\u0633\u062a\u0648\u0649 {{target}}.","\u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u0627\u0644\u064a \u0642\u0631\u064a\u0628: {{amount}}.","\u0623\u0646\u062a {{amount}} \u200b\u200b\u0628\u0639\u064a\u062f \u0639\u0646 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0623\u0639\u0644\u0649.","Almost \u0647\u0646\u0627\u0643: {{amount}} \u200b\u200b\u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u0627\u0644\u064a."],tamagotchiSpeechLevelUp:["\u0645\u0633\u062a\u0648\u0649 \u062c\u062f\u064a\u062f: {{level}}!","\u062a\u0645 \u0641\u062a\u062d \u0627\u0644\u0645\u0633\u062a\u0648\u0649 {{level}}.","\u064a\u0635\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 {{level}}!","\u0644\u0642\u062f \u0648\u0635\u0644\u062a \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 {{level}}.","\u0627\u0644\u0645\u0633\u062a\u0648\u0649 {{level}} \u200b\u200b\u064a\u0628\u062f\u0648 \u062c\u064a\u062f\u064b\u0627 \u0639\u0644\u064a\u0643."],tamagotchiSpeechChallenge:["\u0627\u0644\u062a\u0632\u0645 \u0628\u0640 \"{{title}}\".","\"{{title}}\" - \u0627\u0633\u062a\u0645\u0631.","\u0623\u0646\u0627 \u0645\u0639\u0643 \u0641\u064a \"{{title}}\".","\u062e\u0637\u0648\u0629 \u0623\u062e\u0631\u0649 \u0639\u0644\u0649 \"{{title}}\".","\u0644\u0627 \u064a\u0632\u0627\u0644 \"{{title}}\" \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644.","\u0644\u0627 \u062a\u0633\u0642\u0637 \"{{title}}\".","\u0627\u0628\u0642 \u0639\u0644\u0649 \"{{title}}\"."],tamagotchiSpeechGeneral:["\u0623\u0646\u0627 \u0647\u0646\u0627.","\u0643\u064a\u0641 \u0647\u0648 \u0634\u0639\u0648\u0631\u0643\u061f","\u0627\u0633\u062a\u0645\u0631 \u0641\u064a \u0630\u0644\u0643.","\u0644\u0642\u062f \u062d\u0635\u0644\u0646\u0627 \u0639\u0644\u0649 \u0647\u0630\u0627.","\u0623\u0646\u0627 \u0623\u0634\u0627\u0647\u062f. \u0628\u0644\u0637\u0641."],tamagotchiSpeechFriendly:["\u0623\u0646\u0627 \u0631\u0642\u064a\u0642 \u0644\u0644\u063a\u0627\u064a\u0629 \u0627\u0644\u064a\u0648\u0645.","\u0644\u0642\u062f \u062c\u0644\u0628\u062a \u0644\u0643 \u0627\u0644\u062d\u0638.","\u0630\u064a\u0644\u064a \u064a\u0642\u0648\u0644 \u0645\u0631\u062d\u0628\u0627.","\u0623\u0646\u062a \u062a\u0642\u0631\u064a\u0628\u064b\u0627 \u0623\u0633\u0637\u0648\u0631\u0629.","\u064a\u0628\u062a\u0633\u0645. \u0623\u0646\u0627 \u0647\u0646\u0627.","\u0623\u0646\u0627 \u0623\u0645\u0632\u062d. \u0641\u064a \u0627\u0644\u063a\u0627\u0644\u0628.","\u0623\u0646\u0627 \u0642\u0637\u0629. \u0623\u062a\u0630\u0643\u0631."],tamagotchiSpeechSelfCare:["\u062e\u0630 \u0648\u0642\u0641\u0629.","\u0627\u0644\u0634\u0627\u064a \u0627\u0644\u062f\u0627\u0641\u0626\u060c \u062b\u0645 \u0627\u0630\u0647\u0628.","\u0627\u0644\u0628\u0627\u0642\u064a \u0647\u0648 \u0627\u0644\u0641\u0648\u0632.","\u062e\u0645\u0633 \u062f\u0642\u0627\u0626\u0642 \u0647\u0627\u062f\u0626\u0629 \u0627\u0644\u0639\u062f."],tamagotchiSpeechFocus:["\u0641\u0648\u0632 \u0648\u0627\u062d\u062f \u0635\u063a\u064a\u0631 \u0627\u0644\u064a\u0648\u0645.","\u062a\u062e\u0637\u064a \u0635\u063a\u064a\u0631 \u064a\u062f\u0642 \u0627\u0644\u0646\u062f\u0645.","\u0631\u0643\u0632. \u064a\u062a\u0646\u0641\u0633.","\u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629\u060c \u0633\u0647\u0644\u0629.","\u0627\u0644\u062a\u0631\u0643\u064a\u0632: \"{{title}}\".","\u0627\u0628\u0642 \u0639\u0644\u0649 \"{{title}}\".","\u0623\u0648\u0644\u0648\u064a\u0629 \u0627\u0644\u064a\u0648\u0645: \"{{title}}\".","\u0642\u0641\u0644 \u0639\u0644\u0649 \"{{title}}\"."],tamagotchiSpeechFocusActive:["\u064a\u0646\u0635\u0628 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \"{{title}}\".","\u0627\u0633\u062a\u0645\u0631 \u0641\u064a \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \"{{title}}\".","\u062a\u0631\u0643\u064a\u0632 \u0627\u0644\u064a\u0648\u0645: \"{{title}}\".","\u0623\u0628\u0642\u0650 \"{{title}}\" \u0641\u064a \u0628\u0624\u0631\u0629 \u0627\u0644\u062a\u0631\u0643\u064a\u0632.","\u062a\u0630\u0643\u064a\u0631 \u0627\u0644\u062a\u0631\u0643\u064a\u0632: \"{{title}}\"."],tamagotchiSpeechRemember:["\u0647\u0644 \u062a\u062a\u0630\u0643\u0631 \"{{title}}\" \u0628\u0627\u0644\u0623\u0645\u0633\u061f","\u0628\u0627\u0644\u0623\u0645\u0633 \u0643\u0627\u0646 \"{{title}}\".","\u0645\u0627\u0632\u0644\u062a \u062a\u062a\u0630\u0643\u0631 \"{{title}}\".","\"{{title}}\" \u0639\u0627\u0644\u0642\u0629 \u0641\u064a \u0631\u0623\u0633\u064a."],tamagotchiSpeechBudgetCategoryRemaining:["\u0644\u062f\u064a\u0643 {{amount}} \u200b\u200b\u0645\u062a\u0628\u0642\u064a\u0629 \u0644\u0640 \"{{category}}\" \u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631.","\"{{category}}\" \u0644\u062f\u064a\u0647 {{amount}} \u0645\u062a\u0628\u0642\u064a.","\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \"{{category}}\": {{amount}} \u0627\u0644\u064a\u0633\u0627\u0631.","\u0644\u0627 \u064a\u0632\u0627\u0644 {{amount}} \u200b\u200b\u0644\u0640 \"{{category}}\".","\"{{category}}\" \u0644\u062f\u064a\u0647 {{amount}} \u0641\u064a \u0627\u0644\u062e\u0632\u0627\u0646."],tamagotchiSpeechBudgetCategoryLow:["\"{{category}}\" \u0641\u0627\u0631\u063a \u062a\u0642\u0631\u064a\u0628\u064b\u0627: {{amount}} \u0639\u0644\u0649 \u0627\u0644\u064a\u0633\u0627\u0631.","\u0627\u0644\u062d\u062f \"{{category}}\" \u0631\u0641\u064a\u0639 - {{amount}} \u0627\u0644\u0645\u062a\u0628\u0642\u064a.","\u0643\u0646 \u062d\u0630\u0631\u064b\u0627 \u0645\u0639 \"{{category}}\": \u0628\u0642\u064a \u0641\u0642\u0637 {{amount}}.","\"{{category}}\" \u064a\u0639\u0648\u062f \u0625\u0644\u0649 {{amount}}.","\"{{category}}\" \u064a\u0628\u0644\u063a \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u062a\u0642\u0631\u064a\u0628\u064b\u0627: {{amount}} \u0639\u0644\u0649 \u0627\u0644\u064a\u0633\u0627\u0631."],tamagotchiSpeechBudgetCategoryOver:["\"{{category}}\" \u0627\u0646\u062a\u0647\u0649 \u0628\u0648\u0627\u0633\u0637\u0629 {{amount}}.","\u062a\u062c\u0627\u0648\u0632 \"{{category}}\" \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0628\u0640 {{amount}}.","\u062a\u0645 \u0627\u0644\u0625\u0641\u0631\u0627\u0637 \u0641\u064a \u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0639\u0644\u0649 \"{{category}}\" \u0628\u0648\u0627\u0633\u0637\u0629 {{amount}}.","\"{{category}}\" \u0628\u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0623\u062d\u0645\u0631 \u0628\u0648\u0627\u0633\u0637\u0629 {{amount}}.","\u062a\u062c\u0627\u0648\u0632 \"{{category}}\" \u0627\u0644\u062e\u0637: {{amount}} \u0627\u0646\u062a\u0647\u0649."],tamagotchiSpeechBudgetMonthRemaining:["{{amount}} \u200b\u200b\u0645\u062a\u0628\u0642\u064a \u0644\u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631.","\u0628\u0642\u064a \u0644\u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631 {{amount}} \u200b\u200b\u0644\u0644\u0625\u0646\u0641\u0627\u0642.","\u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0645\u062a\u0628\u0642\u064a: {{amount}}.","{{amount}} \u200b\u200b\u0644\u0627 \u064a\u0632\u0627\u0644 \u0645\u062a\u0627\u062d\u064b\u0627 \u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631.","{{amount}} \u200b\u200b\u063a\u0627\u062f\u0631 \u0641\u064a {{month}}."],tamagotchiSpeechBudgetMonthOver:["\u0644\u0642\u062f \u0627\u0646\u062a\u0647\u0649 \u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631 \u0628\u0627\u0644\u0641\u0639\u0644 {{amount}}.","\u0627\u0646\u062a\u0647\u062a \u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0627\u0644\u0634\u0647\u0631\u064a\u0629 \u0628\u062d\u0644\u0648\u0644 {{amount}}.","\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0634\u0647\u0631 \u0628\u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0623\u062d\u0645\u0631: {{amount}}.","\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u0634\u0647\u0631 \u0628\u0648\u0627\u0633\u0637\u0629 {{amount}}.","\u062a\u0645 \u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0634\u0647\u0631 \u0628\u0648\u0627\u0633\u0637\u0629 {{amount}}."],tamagotchiSpeechBudgetEssential:["\u064a\u0648\u0645 \u0627\u0644\u062f\u0641\u0639 \"{{category}}\"\u061f \u0622\u0633\u0641.","\"{{category}}\" \u062b\u0642\u064a\u0644. \u0634\u0646\u0642 \u0647\u0646\u0627\u0643.","\u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u0625\u0644\u0632\u0627\u0645\u064a\u0629 \u062d\u0642\u064a\u0642\u064a\u0629. \u0644\u0627\u062d\u0638\u062a \"{{category}}\".","\u0622\u0645\u0644 \u0623\u0646 \u064a\u0643\u0648\u0646 \"{{category}}\" \u063a\u064a\u0631 \u0645\u0624\u0644\u0645 \u0627\u0644\u064a\u0648\u0645.","\u062a\u0636\u0631\u0631\u062a \u0645\u062f\u0641\u0648\u0639\u0627\u062a \"{{category}}\" \u0628\u0634\u062f\u0629. \u0623\u0646\u0627 \u0645\u0639\u0643.","\u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u064a\u0648\u0645 \"{{category}}\"\u060c \u0641\u0623\u0646\u0627 \u0623\u0634\u0639\u0631 \u0628\u0643."],tamagotchiSkinFeedbackSubject:"\u0631\u062f\u0648\u062f \u0627\u0644\u0641\u0639\u0644 \u0644 Almost",tamagotchiSkinFeedbackBody:"\u0645\u0631\u062d\u0628\u064b\u0627 \u0641\u0631\u064a\u0642 Almost! \u0645\u0634\u0627\u0631\u0643\u0629 \u0623\u0641\u0643\u0627\u0631\u064a \u062d\u0648\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642:\\n\\n",heroAwaiting:"\u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u0647\u062f\u0627\u0641",heroSpendLine:{female:"\u0622\u062e\u0631 \u062d\u0641\u0638: \"{{title}}\".",male:"\u0622\u062e\u0631 \u062d\u0641\u0638: \"{{title}}\".",none:"\u0622\u062e\u0631 \u062d\u0641\u0638: \"{{title}}\"."},heroSpendRecentTitle:"\u0627\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0623\u062e\u064a\u0631:",heroSpendFallback:"\u0643\u0644 \u0648\u0642\u0641\u0629 \u0645\u062f\u0631\u0648\u0633\u0629 \u062a\u063a\u0630\u064a \u0635\u0646\u062f\u0648\u0642 \u0627\u0644\u062d\u0631\u064a\u0629",heroEconomyContinues:"\u064a\u0633\u062a\u0645\u0631 \u0627\u0644\u0627\u062f\u062e\u0627\u0631.",heroExpand:"\u0625\u0638\u0647\u0627\u0631 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644",heroCollapse:"\u0625\u062e\u0641\u0627\u0621 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644",heroDailyTitle:"\u0627\u0644\u0627\u062f\u062e\u0627\u0631 / \u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a",heroDailyEmpty:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u062a\u062e\u0637\u064a \u0628\u0639\u062f. \u062d\u0627\u0648\u0644 \u0627\u0644\u0627\u062f\u062e\u0627\u0631 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0647\u0630\u0627 \u0627\u0644\u0623\u0633\u0628\u0648\u0639.",defaultDeclineLabel:"\u064a\u062a\u062e\u0637\u0649",defaultSpendLabel:"\u064a\u0646\u0641\u0642",defaultWishTitle:"\u0647\u062f\u0641",heroWeeklySavingsDelta:"\u0623\u0646\u0642\u0630",heroWeeklySpendingDelta:"\u0642\u0636\u0649",feedEmptyTitle:"\u0644\u0627 \u0634\u064a\u0621 \u0647\u0646\u0627",feedEmptySubtitle:"\u062c\u0631\u0628 \u0639\u0644\u0627\u