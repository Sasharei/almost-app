32\u044b \u0443\u0436\u0435 \u0442\u0440\u0438\u0436\u0434\u044b \u043f\u043e\u0434\u0440\u044f\u0434 \u043d\u0430\u0436\u0430\u043b\u0438 \xab\u0441\u044d\u043a\u043e\u043d\u043e\u043c\u043b\u0435\u043d\u043e\xbb \u043d\u0430 \u044d\u0442\u043e\u0439 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0435 \u0437\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u043f\u044f\u0442\u044c \u043c\u0438\u043d\u0443\u0442. \u0421\u0434\u0435\u043b\u0430\u0439\u0442\u0435 \u043f\u0430\u0443\u0437\u0443, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044c \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0445 \u043d\u0430\u0436\u0430\u0442\u0438\u0439.",saveSpamWarningGlobal:"\u0421\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u043d\u043e\u0433\u043e \u0431\u044b\u0441\u0442\u0440\u044b\u0445 \u043d\u0430\u0436\u0430\u0442\u0438\u0439 \xab\u0441\u044d\u043a\u043e\u043d\u043e\u043c\u043b\u0435\u043d\u043e\xbb. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435, \u0447\u0442\u043e \u044d\u0442\u043e \u043d\u0435 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u044c, \u0438 \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0447\u0443\u0442\u044c \u043f\u043e\u0437\u0436\u0435.",saveSpamModalTitle:"\u0422\u0443\u0440\u0431\u043e-\u043a\u043b\u0438\u043a\u0438 \u0437\u0430\u043c\u0435\u0447\u0435\u043d\u044b \ud83d\ude3c",saveSpamModalBody:"\u0412\u044b \u0443\u0436\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437 \u043f\u043e\u0434\u0440\u044f\u0434 \u043e\u0442\u043c\u0435\u0442\u0438\u043b\u0438 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u044e. \u0415\u0441\u043b\u0438 \u044d\u0442\u043e \u0440\u0435\u0430\u043b\u044c\u043d\u043e \u043d\u043e\u0432\u044b\u0439 \u043e\u0442\u043a\u0430\u0437 - \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435. \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u043c\u0430\u0445 - \u043e\u0442\u043c\u0435\u043d\u0438\u043c, \u0441\u0443\u043c\u