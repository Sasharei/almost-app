ead of grabbing {{temptation}} again. \ud83c\udf1f":"\u0623\u0636\u0641 {{amount}} \u200b\u200b\u0625\u0644\u0649 \u0627\u0644\u062d\u0644\u0645 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0627\u0633\u062a\u064a\u0644\u0627\u0621 \u0639\u0644\u0649 {{temptation}} \u0645\u0631\u0629 \u0623\u062e\u0631\u0649. \ud83c\udf1f",Food:"\u0637\u0639\u0627\u0645","Foam soap":"\u0635\u0627\u0628\u0648\u0646 \u0631\u063a\u0648\u064a",Rent:"\u0625\u064a\u062c\u0627\u0631",Utilities:"\u0627\u0644\u0645\u0631\u0627\u0641\u0642",Car:"\u0633\u064a\u0627\u0631\u0629",Home:"\u0628\u064a\u062a",Transport:"\u064a\u0646\u0642\u0644",Health:"\u0635\u062d\u0629","Bubbly soap":"\u0635\u0627\u0628\u0648\u0646 \u0634\u0645\u0628\u0627\u0646\u064a\u0627","Soft brush":"\u0641\u0631\u0634\u0627\u0629 \u0646\u0627\u0639\u0645\u0629","Massage brush":"\u0641\u0631\u0634\u0627\u0629 \u0627\u0644\u062a\u062f\u0644\u064a\u0643",Beauty:"\u062c\u0645\u0627\u0644","Dreamer alert \ud83d\ude3b":"\u062a\u0646\u0628\u064a\u0647 \u062d\u0627\u0644\u0645 \ud83d\ude3b","Toy mouse":"\u0644\u0639\u0628\u0629 \u0627\u0644\u0641\u0623\u0631",Entertainment:"\u062a\u0631\u0641\u064a\u0647",Shopping:"\u0627\u0644\u062a\u0633\u0648\u0642",Clothing:"\u0645\u0644\u0627\u0628\u0633",Savings:"\u0627\u0644\u0627\u062f\u062e\u0627\u0631",Education:"\u062a\u0639\u0644\u064a\u0645",Subscriptions:"\u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643\u0627\u062a",Pets:"\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0623\u0644\u064a\u0641\u0629","Mandatory payments":"\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0627\u0644\u0625\u0644\u0632\u0627\u0645\u064a\u0629",Sun:"\u0634\u0645\u0633",Mon:"\u0627\u0644\u0627\u062b\u0646\u064a\u0646",Fri:"\u0627\u0644\u062c\u0645\u0639\u0629",Sat:"\u0642\u0639\u062f",Tue:"\u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621",d:"\u062f",Wed:"\u062a\u0632\u0648\u062c",Thu:"\u0627\u0644\u062e\u0645\u064a\u0633","First tier: fewer casual cigarettes and smoke breaks.":"\u0627\u0644\u