u064a\u0644\u0627\u064b.","\u0646\u0635\u064a\u062d\u0629 \u0630\u0643\u064a\u0629: \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u062a\u062a\u062e\u0637\u0649 \u0641\u064a\u0647\u0627 \"{{temptation}}\"\u060c \u0641\u0625\u0646 Almost \u062a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0648\u0636\u0648\u062d \u0631\u0624\u064a\u062a\u0643."],smartInsightDeclineTitle:"\u0641\u0648\u0632 {{dayLabel}}: \"{{temptation}}\"",smartInsightDeclineBody:"\u0642\u0644 \u0644\u0627 \u0645\u062c\u062f\u062f\u064b\u0627 \u0627\u0644\u064a\u0648\u0645 \u0648Almost \u200b\u200b\u0633\u0648\u0641 \u064a\u0633\u062a\u0645\u0631 \u0641\u064a \u0627\u0644\u0633\u0644\u0633\u0644\u0629.",smartInsightSpendTitle:"\u0641\u0627\u0632 \"{{temptation}}\" \u0628\u0640{{dayLabel}}",smartInsightSpendBody:"\u0627\u062d\u062a\u0641\u0638 \u0628\u0627\u0644\u062e\u0637 \u0627\u0644\u064a\u0648\u0645 \u062d\u062a\u0649 \u064a\u062a\u0645\u0643\u0646 Almost \u200b\u200b\u0645\u0646 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0644 \u0628\u0627\u0644\u062a\u0635\u062f\u064a.",dailyNudgeMorningTitle:["\u062f\u0641\u0639\u0629 \u0635\u0628\u0627\u062d\u064a\u0629 \u0645\u0646 Almost","\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0645\u0646 Almi"],dailyNudgeMorningBody:["\u0627\u0636\u0628\u0637 \u0627\u0644\u0646\u063a\u0645\u0629: \u062a\u062e\u0637\u064a \u0627\u0644\u062f\u0627\u0641\u0639 \u0627\u0644\u0623\u0648\u0644 \u0648\u062a\u0630\u0643\u0631 \u0647\u062f\u0641\u0643.","Almi \u200b\u200b\u064a\u0642\u0648\u0645 \u0628\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0648\u0635\u0648\u0644 - \u062a\u0648\u0642\u0641 \u0645\u0624\u0642\u062a\u064b\u0627 \u0642\u0628\u0644 \u0627\u0644\u062a\u0645\u0631\u064a\u0631 \u0627\u0644\u0623\u0648\u0644 \u0627\u0644\u064a\u0648\u0645."],dailyNudgeDayTitle:["\u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0646\u0647\u0627\u0631 Almost \u200b\u200b\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0648\u0635\u0648\u0644","\u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0645\u0646 Almi"],dailyNudgeDayBody:["\u0646\u0628\u0636\u0627\u062a \u0628\u0639\u062f \u0627\u0644\u0638\u0647\u0631 \u062a\u062a\u0633\u0644\u0642. \u0627\u0633\u0623\u0644 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0647\u0630\u0627 \u0627\u0644\u0634\u0631\u0627\u0621 \u0644\u0627 \u064a\u0632\u0627\u0644 \u064a\u062e\u062f\u0645 \u0647\u062f\u0641\u0643.","Almost \u200b\u200b\u0644\u0627\u062d\u0638\u062a \u0627\u0644\u0625\u0633\u0631\u0627\u0641 \u0641\u064a \u0648\u0642\u062a \u0627\u0644\u063a\u062f\u0627\u0621. \u062e\u0630 \u0648\u0642\u0641\u0629 \u0645\u062f\u0631\u0648\u0633\u0629."],dailyNudgeAfternoonTitle:["\u0627\u062e\u062a\u0628\u0627\u0631 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0639\u062f \u0627\u0644\u063a\u062f\u0627\u0621 \u0645\u0646 Almost","\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0641\u0631\u0627\u0645\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Almi"],dailyNudgeAfternoonBody:["\u062e\u0630 \u0646\u0641\u0633\u064b\u0627 \u0642\u0628\u0644 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \"\u0634\u0631\u0627\u0621\" \u0648\u0625\u0639\u0627\u062f\u0629 \u062a\u0648\u062c\u064a\u0647 \u062a\u0644\u0643 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062f\u062e\u0631\u0627\u062a.","\u0627\u0644\u0625\u063a\u0631\u0627\u0621\u0627\u062a \u062a\u0632\u062d\u0641\u061f \u0627\u0645\u0633\u0643 \u0627\u0644\u062e\u0637 \u0648\u062a\u0630\u0643\u0631 \u0647\u062f\u0641\u0643."],dailyNudgeEveningTitle:["\u062f\u0631\u0639 \u0627\u0644\u0645\u0633\u0627\u0621 \u0645\u0646 Almost","Almi \u200b\u200b\u064a\u062e\u062a\u062a\u0645 \u064a\u0648\u0645\u0643"],dailyNudgeEveningBody:["\u0627\u0644\u0623\u0645\u0633\u064a\u0627\u062a \u062a\u063a\u0631\u064a \u0623\u0643\u062b\u0631. \u0633\u062c\u0644 \u0627\u0644\u0641\u0648\u0632 \u0642\u0628\u0644 \u0627\u0644\u0646\u0648\u0645.","\u0627\u062e\u062a\u062a\u0645 \u0627\u0644\u064a\u0648\u0645 \u062f\u0627\u062e\u0644 Almost \u200b\u200b- \u200b\u200b\u062d\u062a\u0649 \u0627\u0644\u062d\u0641\u0638 \u0627\u0644\u0628\u0633\u064a\u0637 \u064a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0627\u0644\u062a\u062d\u0641\u064a\u0632 \u0627\u0644\u0630\u0643\u064a."],dailyNudgeStreak20Title:["\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0641\u064a \u062e\u0637 \u0645\u0633\u0627\u0626\u064a"],dailyNudgeStreak20Body:["\u0642\u0645 \u0628\u062a\u0633\u062c\u064a\u0644 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0631\u0641\u0636 \u0648\u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u062d\u062a\u0649 \u0644\u0627 \u062a\u0646\u062e\u0641\u0636 \u0627\u0644\u0633\u0644\u0633\u0644\u0629."],dailyNudgeStreak21Title:["\u062e\u0637 \u0644\u0627 \u064a\u0632\u0627\u0644 \u064a\u0646\u062a\u0638\u0631"],dailyNudgeStreak21Body:["\u0644\u0627 \u064a\u0648\u062c\u062f \u0633\u062c\u0644 \u062d\u062a\u0649 \u0627\u0644\u0622\u0646\u061f \u062e\u0637\u0643 \u064a\u0633\u062a\u0645\u0631 \u062d\u062a\u0649 \u0645\u0646\u062a\u0635\u0641 \u0627\u0644\u0644\u064a\u0644 \u0641\u0642\u0637."],dailyNudgeStreak22Title:["\u062e\u0637 \u0641\u064a \u062e\u0637\u0631"],dailyNudgeStreak22Body:["\u0644\u0627 \u064a\u0648\u062c\u062f \u0633\u062c\u0644 \u062d\u062a\u0649 \u0627\u0644\u0622\u0646 - \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0631\u0641\u0636 \u0648\u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0645\u0641\u0642\u0648\u062f\u0629."],dailyNudgeStreak23Title:["\u0627\u0644\u0633\u0627\u0639\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0644\u0644\u062e\u0637"],dailyNudgeStreak23Body:["\u062a\u0628\u0642\u0649 \u0633\u0627\u0639\u0629 \u0648\u0627\u062d\u062f\u0629. \u064a\u062a\u0645 \u0631\u0641\u0636 \u0627\u0644\u0633\u062c\u0644 \u0648\u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0623\u0648 \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u062e\u0637."],dailyNudgeStreak2330Title:["\u0627\u0644\u0641\u0631\u0635\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0627\u0644\u0644\u064a\u0644\u0629"],dailyNudgeStreak2330Body:["23:30. \u064a\u062a\u0645 \u0631\u0641\u0636 \u0627\u0644\u0633\u062c\u0644 \u0648\u0625\u0646\u0641\u0627\u0642\u0647 \u0627\u0644\u0622\u0646 \u0623\u0648 \u062a\u062a\u0645 \u0625\u0639\u0627\u062f\u0629 \u0636\u0628\u0637 \u0627\u0644\u062e\u0637."],dailySummaryBadgeLabel:"\u062e\u0644\u0627\u0635\u0629 \u064a\u0648\u0645\u064a\u0629",dailySummaryBadgeCTA:"\u062e\u0644\u0627\u0635\u0629",dailySummaryTitle:"\u062e\u0644\u0627\u0635\u0629 \u0627\u0644\u064a\u0648\u0645",dailySummarySubtitle:"\u0632\u062e\u0645 \u0643\u0628\u064a\u0631 - \u0627\u0633\u062a\u0645\u0631 \u0641\u064a \u0630\u0644\u0643!",dailySummarySubtitleEmpty:"\u064a\u0648\u0645 \u0647\u0627\u062f\u0626 \u0627\u0644\u064a\u0648\u0645. \u0648\u0647\u0630\u0627 \u0644\u0627 \u064a\u0632\u0627\u0644 \u062c\u0632\u0621\u0627 \u0645\u0646 \u0627\u0644\u0639\u0645\u0644\u064a\u0629.",dailySummarySavedLabel:"\u062a\u0645 \u0627\u0644\u062d\u0641\u0638 \u0627\u0644\u064a\u0648\u0645",dailySummarySavedSub:"\u0643\u0644 \u062a\u062e\u0637\u064a \u064a\u062f\u0641\u0639 \u0627\u0644\u0647\u062f\u0641 \u0623\u0642\u0631\u0628",dailySummarySavedSubEmpty:"\u0644\u0627 \u064a\u0648\u062c\u062f \u062d\u0641\u0638 \u0627\u0644\u064a\u0648\u0645 \u062d\u062a\u0649 \u0627\u0644\u0622\u0646. \u064a\u0628\u062f\u0623 \u063a\u062f\u064b\u0627 \u0628\u0641\u0648\u0632 \u0635\u063a\u064a\u0631.",dailySummarySpendsLabel:"\u064a\u0646\u0641\u0642",dailySummaryContinue:"\u064a\u0643\u0645\u0644",dailySummaryBurnLabel:"\u062a\u0646\u062a\u0647\u064a \u0635\u0644\u0627\u062d\u064a\u062a\u0647 \u0641\u064a {{time}}",dailySummaryEmptyMessage:"\u0644\u0645 \u062a\u062a\u0645 \u062d\u0645\u0627\u064a\u0629 \u0623\u064a \u0645\u062f\u062e\u0631\u0627\u062a \u0627\u0644\u064a\u0648\u0645.",dailySummaryEmptyMotivation:"\u063a\u062f\u0627 \u0647\