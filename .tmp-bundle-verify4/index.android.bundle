45\u062c\u0627\u0646\u064a \u0641\u064a \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0633\u0644\u0633\u0644\u0629 \u0645\u0646 \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u062a\u064a \u0644\u0627 \u064a\u0648\u062c\u062f \u0641\u064a\u0647\u0627 \u0625\u0646\u0641\u0627\u0642.",featureUnlockWhereLabel:"\u0623\u064a\u0646 \u064a\u0639\u064a\u0634",featureUnlockPreviewLabel:"\u064a\u0628\u062f\u0648 \u0645\u062b\u0644 \u0647\u0630\u0627",featureLockedLevelLabel:"\u064a\u0641\u062a\u062d \u0639\u0646\u062f \u0627\u0644\u0645\u0633\u062a\u0648\u0649 {{level}}",featureLockedPremiumLabel:"\u0645\u062a\u0648\u0641\u0631 \u0641\u064a Premium",featureUnlockDidYouKnowBadge:"\u0647\u0644 \u062a\u0639\u0644\u0645\u061f",featureUnlockRewardsDailyTitle:"\u0645\u0643\u0627\u0641\u0623\u0629 \u064a\u0648\u0645\u064a\u0629",featureUnlockRewardsDailyDescription:"\u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 Almi: \u0627\u0644\u0645\u0643\u0627\u0641\u0623\u0629 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0623\u0635\u0628\u062d\u062a \u0627\u0644\u0622\u0646 \u062f\u0627\u062e\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c.",featureUnlockRewardsDailyPremiumDescription:"\u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 Almi \u200b\u200b\u0644\u062c\u0645\u0639 \u0645\u0643\u0627\u0641\u0623\u062a\u0643 \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0646\u0645\u0648\u0630\u062c.",featureUnlockRewardsDailyPreview:"\u0645\u0643\u0627\u0641\u0623\u0629 \u064a\u0648\u0645\u064a\u0629",featureUnlockFeedFocusTitle:"\u062a\u063a\u0630\u064a\u0629 + \u062a\u0641\u0643\u064a\u0631",featureUnlockFeedFocusDescription:"\u0641\u062a\u062d \u0627\u0644\u062e\u0644\u0627\u0635\u0629: \u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0648\u0627\u0644\u0645\u0644\u062e\u0635 \u0627\u0644\u0645\u0633\u0627\u0626\u064a \u0641\u064a \u0627\u0644\u0623\u0639\u0644\u0649. \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0644\u062a\u0642\u0631\u0631 \u0644\u0627\u062d\u0642\u064b\u0627.",featureUnlockFeedFocusPremiumDescription:"\u0627\u0641\u062a\u062d \u0627\u0644\u0645\u0648\u062c\u0632 \u0644\u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0648\u0627\u0644\u0645\u0644\u062e\u0635 \u0627\u0644\u0645\u0633\u0627\u0626\u064a\u060c \u062b\u0645 \u0627\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0644\u0627\u062a\u062e\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631 \u0644\u0627\u062d\u0642\u064b\u0627.",featureUnlockFeedFocusPreview:"\u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632",featureUnlockRewardsCustomizationTitle:"\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a",featureUnlockRewardsCustomizationDescription:"\u062a\u0639\u0631\u0636 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a \u0627\u0644\u0622\u0646 \u0627\u0644\u062c\u0648\u0627\u0626\u0632 \u0648\u0627\u0644\u062a\u0642\u062f\u0645 \u0648\u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u062a\u0631\u0643\u064a\u0632.",featureUnlockRewardsCustomizationPremiumDescription:"\u062a\u0639\u0631\u0636 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a \u0627\u0644\u062c\u0648\u0627\u0626\u0632 \u0648\u0627\u0644\u062a\u0642\u062f\u0645 \u0648\u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u062a\u0631\u0643\u064a\u0632.",featureUnlockRewardsCustomizationPreview:"\u0639\u0644\u0627\u0645\u0629 \u062a\u0628\u0648\u064a\u0628 \u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a",featureUnlockCatCustomizationTitle:"Almi \u200b\u200b\u0627\u0644\u062a\u062e\u0635\u064a\u0635",featureUnlockCatCustomizationDescription:"\u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 Almi \u200b\u200b\u0644\u0641\u062a\u062d \u0627\u0644\u0623\u0633\u0637\u062d \u0648\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0645\u0638\u0647\u0631.",featureUnlockCatCustomizationPremiumDescription:"\u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 Almi \u200b\u200b\u0644\u0641\u062a\u062d \u0627\u0644\u0623\u0633\u0637\u062d \u0648\u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0645\u0638\u0647\u0631.",featureUnlockCatCustomizationPreview:"Almi \u200b\u200b\u062c\u0644\u0648\u062f",featureUnlockReportsTitle:"\u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a\u0629 \u0648\u0627\u0644\u0634\u0647\u0631\u064a\u0629",featureUnlockReportsDescription:"\u0641\u064a \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u0645\u062a\u0648\u0641\u0631\u0629 \u0641\u064a Premium.",featureUnlockReportsPremiumDescription:"\u0641\u064a \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0627\u062a\u062c\u0627\u0647\u0627\u062a \u0627\u0644\u0623\u0633\u0628\u0648\u0639\u064a\u0629 \u0648\u0627\u0644\u0634\u0647\u0631\u064a\u0629.",featureUnlockReportsPreview:"\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u2192 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631",featureUnlockRewardsChallengesTitle:"\u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a \u2192 \u0627\u0644\u062a\u062d\u062f\u064a\u0627\u062a",featureUnlockRewardsChallengesDescription:"\u0641\u064a \u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062a\u060