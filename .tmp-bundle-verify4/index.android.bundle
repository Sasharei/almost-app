\u0442. \xab{{title}}\xbb \u043d\u0435 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u043f\u043e\u0431\u0435\u0434\u0430.","\u041e\u043a\u0435\u0439, \xab{{title}}\xbb \u0441\u043b\u0443\u0447\u0438\u043b\u0441\u044f. \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0432\u044b\u0431\u043e\u0440 - \u043d\u0430\u0448.","\xab{{title}}\xbb - \u043d\u0435 \u043a\u043e\u043d\u0435\u0446. \u0421\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0448\u0430\u0433 \u0432\u0430\u0436\u043d\u0435\u0435."],tamagotchiSpeechSpendRegretGeneric:["\u0411\u044b\u0432\u0430\u0435\u0442. \u0414\u0430\u043b\u044c\u0448\u0435 \u0431\u0443\u0434\u0435\u0442 \u043b\u0443\u0447\u0448\u0435.","\u041d\u0435 \u0440\u0443\u0433\u0430\u044e. \u0413\u043b\u0430\u0432\u043d\u043e\u0435 - \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0432\u044b\u0431\u043e\u0440.","\u0421\u043b\u0443\u0447\u0438\u043b\u043e\u0441\u044c. \u0414\u0435\u0440\u0436\u0438\u043c \u043a\u0443\u0440\u0441.","\u041d\u0438\u0447\u0435\u0433\u043e. \u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043c.","\u042f \u0440\u044f\u0434\u043e\u043c. \u0418\u0434\u0451\u043c \u0434\u0430\u043b\u044c\u0448\u0435."],tamagotchiSpeechGoalComplete:["\u0426\u0435\u043b\u044c \u0437\u0430\u043a\u0440\u044b\u0442\u0430! \u0427\u0442\u043e \u0434\u0430\u043b\u044c\u0448\u0435?","\u0426\u0435\u043b\u044c \u0433\u043e\u0442\u043e\u0432\u0430. \u041d\u043e\u0432\u0430\u044f \u043c\u0435\u0447\u0442\u0430?","\u0413\u043e\u0442\u043e\u0432\u043e! \u041c\u043e\u0436\u043d\u043e \u043d\u043e\u0432\u0443\u044e \u0446\u0435\u043b\u044c."],tamagotchiSpeechGoalProgress:["\u0414\u043e \u0446\u0435\u043b\u0438 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c {{amount}}.","\u0415\u0449\u0451 {{amount}} - \u0438 \u0446\u0435\u043b\u044c.","\u041f\u043e\u0447\u0442\u0438 \u0442\u0430\u043c: {{amount}}."],tamagotchiSpeechChallengeProgress:["\u0427\u0435\u043b\u043b\u0435\u043d\u0434\u0436 \xab{{title}}\xbb: {{progress}}.","\u041f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u043f\u043e \xab{{title}}\xbb: {{progress}}.","\u0412 \xab{{title}}\xbb \u0443\u0436\u0435 {{progress}}.","\u0427\u0435\u043b\u043b\u0435\u043d\u0434\u0436 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044f: {{progress}}.","\u0428\u0430\u0433\u0438 \u043f\u043e \xab{{title}}\xbb: {{progress}}."],tamagotchiSpeechLevelProgress:["\u0414\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f {{amount}}.","\u0415\u0449\u0451 {{amount}} \u0434\u043e \u0443\u0440\u043e\u0432\u043d\u044f {{target}}.","\u041d\u043e\u0432\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c \u0431\u043b\u0438\u0437\u043a\u043e: {{amount}}.","\u041e\u0441\u0442\u0430\u043b\u043e\u0441\u044c {{amount}} \u0434\u043e \u0430\u043f\u0433\u0440\u0435\u0439\u0434\u0430.","\u041f\u043e\u0447\u0442\u0438 \u0442\u0430\u043c: {{amount}} \u0434\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f."],tamagotchiSpeechLevelUp:["\u041d\u043e\u0432\u044b\u0439 \u0443\u0440\u043e\u0432\u0435\u043d\u044c: {{level}}!","\u0423\u0440\u043e\u0432\u0435\u043d\u044c {{level}} \u043e\u0442\u043a\u0440\u044b\u0442.","\u0410\u043f! \u0422\u044b \u043d\u0430 \u0443\u0440\u043e\u0432\u043d\u0435 {{level}}.","\u0423\u0440\u043e\u0432\u0435\u043d\u044c {{level}} - \u044d\u0442\u043e \u043c\u043e\u0449\u043d\u043e.","\u041f\u043e\u0437\u0434\u0440\u0430\u0432\u043b\u044f\u044e \u0441 \u0443\u0440\u043e\u0432\u043d\u0435\u043c {{level}}!"],tamagotchiSpeechChallenge:["\u0414\u0435\u0440\u0436\u0438\u0441\u044c \u0432 \xab{{title}}\xbb.","\u0427\u0435\u043b\u043b\u0435\u043d\u0434\u0436 \xab{{title}}\xbb - \u0442\u044b \u043c\u043e\u0436\u0435\u0448\u044c.","\u042f \u0440\u044f\u0434\u043e\u043c \u0432 \xab{{title}}\xbb.","\u0428\u0430\u0433 \u0432 \xab{{title}}\xbb - \u0438 \u0432\u043f\u0435\u0440\u0451\u0434.","\u0427\u0435\u043b\u043b\u0435\u043d\u0434\u0436 \xab{{title}}\xbb \u0436\u0434\u0451\u0442.","\u041d\u0435 \u0431\u0440\u043e\u0441\u0430\u0439 \xab{{title}}\xbb.","\u041f\u043e \xab{{title}}\xbb \u0434\u0435\u0440\u0436\u0438\u043c \u043a\u0443\u0440\u0441."],tamagotchiSpeechGeneral:["\u042f \u0440\u044f\u0434\u043e\u043c.","\u041a\u0430\u043a \u043d\u0430\u0441\u0442\u0440\u043e\u0439?","\u041f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0439 \u0442\u0430\u043a \u0436\u0435.","\u041c\u044b \u0441\u043f\u0440\u0430\u0432\u0438\u043c\u0441\u044f.","\u042f \u0441\u043b\u0435\u0436\u0443. \u041b\u0430\u0441\u043a\u043e\u0432\u043e."],tamagotchiSpeechFriendly:["\u042f \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u043f\u0443\u0448\u0438\u0441\u0442\u044b\u0439.","\u042f \u043f\u0440\u0438\u043d\u0451\u0441 \u0443\u0434\u0430\u0447\u0443.","\u041c\u043e\u0439 \u0445\u0432\u043e\u0441\u0442 - \u043d\u0430 \u0443\u0434\u0430\u0447\u0443.","\u0422\u044b \u043f\u043e\u0447\u0442\u0438 \u043b\u0435\u0433\u0435\u043d\u0434\u0430.","\u0423\u043b\u044b\u0431\u043d\u0438\u0441\u044c. \u042f \u0437\u0434\u0435\u0441\u044c.","\u042f \u0448\u0443\u0447\u0443. \u041f\u043e\u0447\u0442\u0438.","\u042f \u043a\u043e\u0442. \u042f \u0432\u0441\u0451 \u043f\u043e\u043c\u043d\u044e."],tamagotchiSpeechSelfCare:["\u0421\u0434\u0435\u043b\u0430\u0439 \u043f\u0430\u0443\u0437\u0443.","\u0422\u0451\u043f\u043b\u044b\u0439 \u0447\u0430\u0439 - \u0438 \u0432 \u0431\u043e\u0439.","\u041e\u0442\u0434\u044b\u0445 \u0442\u043e\u0436\u0435 \u043f\u043e\u0431\u0435\u0434\u0430.","\u041f\u044f\u0442\u044c \u043c\u0438\u043d\u0443\u0442 \u0442\u0438\u0448\u0438\u043d\u044b - \u043e\u043a."],tamagotchiSpeechFocus:["\u041e\u0434\u043d\u0430 \u043f\u043e\u0431\u0435\u0434\u0430 - \u0438 \u0432\u0441\u0451.","\u041c\u0430\u043b\u044b\u0439 \u0448\u0430\u0433 \u0432\u0430\u0436\u0435\u043d.","\u0424\u043e\u043a\u0443\u0441. \u0414\u044b\u0448\u0438\u043c.","\u0414\u0430\u043b\u044c\u0448\u0435 - \u043f\u043e \u043f\u043b\u0430\u043d\u0443.","\u0424\u043e\u043a\u0443\u0441: \xab{{title}}\xbb.","\u0414\u0435\u0440\u0436\u0438 \u0444\u043e\u043a\u0443\u0441 \u043d\u0430 \xab{{title}}\xbb.","\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0433\u043b\u0430\u0432\u043d\u043e\u0435 - \xab{{title}}\xbb.","\u0424\u043e\u043a\u0443\u0441\u0438\u0440\u0443\u0435\u043c \xab{{title}}\xbb."],tamagotchiSpeechFocusActive:["\u0424\u043e\u043a\u0443\u0441 \u0430\u043a\u0442\u0438\u0432\u0435\u043d: \xab{{title}}\xbb.","\u0414\u0435\u0440\u0436\u0438\u043c \u0444\u043e\u043a\u0443\u0441 \u043d\u0430 \xab{{title}}\xbb.","\u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0432 \u0444\u043e\u043a\u0443\u0441\u0435 \xab{{title}}\xbb.","\u0424\u043e\u043a\u0443\u0441 \u0434\u0435\u0440\u0436\u0438\u0442 \xab{{title}}\xbb.","\u041d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \u0444\u043e\u043a\u0443\u0441: \xab{{title}}\xbb."],tamagotchiSpeechRemember:["\u041f\u043e\u043c\u043d\u0438\u0448\u044c \xab{{title}}\xbb \u0432\u0447\u0435\u0440\u0430?","\u0412\u0447\u0435\u0440\u0430 \u0431\u044b\u043b\u043e \xab{{title}}\xbb.","\xab{{title}}\xbb \u0435\u0449\u0451 \u043f\u043e\u043c\u043d\u044e.","\u041f\u0440\u043e \xab{{title}}\xbb \u043d\u0435 \u0437\u0430\u0431\u044b\u043b."],tamagotchiSpeechBudgetCategoryRemaining:["\u041d\u0430 \xab{{category}}\xbb \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c {{amount}} \u0432 \u044d\u0442\u043e\u043c \u043c\u0435\u0441\u044f\u0446\u0435.","\u041f\u043e \xab{{category}}\xbb \u0435\u0449\u0451 {{amount}}.","\u041b\u0438\u043c\u0438\u0442 \xab{{category}}\xbb: \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c {{amount}}.","\u0411\u044e\u0434\u0436\u0435\u0442 \xab{{category}}\xbb: {{amount}} \u0432 \u0437\u0430\u043f\u0430\u0441\u0435.","\xab{{category}}\xbb \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044f: \u043e\u0441\u0442\u0430\u0442\u043e\u043a {{amount}}.","\u0412 \xab{{category}}\xbb \u0435\u0449\u0451 {{amount}} \u043c\u043e\u0436\u043d\u043e.","\u0417\u0430\u043f\u0430\u0441 \u043f\u043e \xab{{category}}\xbb - {{amount}}."],tamagotchiSpeechBudgetCategoryLow:["\xab{{category}}\xbb \u043f\u043e\u0447\u0442\u0438 \u043d\u0430 \u043d\u0443\u043b\u0435: {{amount}} \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c.","\u041b\u0438\u043c\u0438\u0442 \xab{{category}}\xbb \u0442\u0430\u0435\u0442. \u041e\u0441\u0442\u0430\u0442\u043e\u043a {{amount}}.","\u041f\u043e \xab{{category}}\xbb \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0432\u0441\u0435\u043c \u043d\u0435\u043c\u043d\u043e\u0433\u043e: {{amount}}.","\u041e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e \u0441 \xab{{category}}\xbb: \u0432\u0441\u0435\u0433\u043e {{amount}}.","\xab{{category}}\xbb \u043d\u0430 \u0442\u043e\u043d\u0435\u043d\u044c\u043a\u043e\u0433\u043e: {{amount}}.","\xab{{category}}\xbb \u0443\u0436\u0435 \u043d\u0430 \u0444\u0438\u043d\u0438\u0448\u0435: {{amount}}.","\u041f\u043e\u0447\u0442\u0438 \u0432\u0441\u0451 \u043f\u043e \xab{{category}}\xbb. \u041e\u0441\u0442\u0430\u0442\u043e\u043a {{amount}}."],tamagotchiSpeechBudgetCategoryOver:["\u041f\u043e \xab{{category}}\xbb \u0443\u0436\u0435 \u043c\u0438\u043d\u0443\u0441 {{amount}}.","\xab{{category}}\xbb \u0432\u044b\u0448\u043b\u0430 \u0437\u0430 \u043b\u0438\u043c\u0438\u0442 \u043d\u0430 {{amount}}.","\u041f\u0435\u0440\u0435\u0440\u0430\u0441\u0445\u043e\u0434 \u043f\u043e \xab{{category}}\xbb: {{amount}}.","\xab{{category}}\xbb \u0432 \u043c\u0438\u043d\u0443\u0441\u0435 \u043d\u0430 {{amount}}.","\u041b\u0438\u043c\u0438\u0442 \xab{{category}}\xbb \u043f\u0440\u0435\u0432\u044b\u0448\u0435\u043d \u043d\u0430 {{amount}}.","\xab{{category}}\xbb \u0441\u044a\u0435\u043b\u0430 \u043b\u0438\u0448\u043d\u0435\u0435: {{amount}}.","\u041e\u043f\u0430, \xab{{category}}\xbb \u043f\u0435\u0440\u0435\u0431\u043e\u0440\u0449\u0438\u043b\u0430 \u043d\u0430 {{amount}}."],tamagotchiSpeechBudgetMonthRemaining:["\u041d\u0430 \u044d\u0442\u043e\u0442 \u043c\u0435\u0441\u044f\u0446 \u043e\u0441\u0442\u0430\u043b\u