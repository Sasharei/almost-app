__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.LANGUAGE_MAP_FALLBACK_TRANSLATIONS=void 0;e.LANGUAGE_MAP_FALLBACK_TRANSLATIONS={de:{en:"de","en-US":"en-US","\u201cWealth is the slave of a wise man and the master of a fool.\u201d Seneca":"\u201eReichtum ist der Sklave eines Weisen und der Herr eines Narren.\u201c Seneca",English:"Englisch","\u201cA penny saved is a penny earned.\u201d Benjamin Franklin":"\u201eEin gesparter Penny ist ein verdienter Penny.\u201c Benjamin Franklin","\u201cNever spend your money before you have it.\u201d Thomas Jefferson":"\u201eGib niemals dein Geld aus, bevor du es hast.\u201c Thomas Jefferson",Yearly:"J\xe4hrlich",Monthly:"Monatlich",Premium:"Premium",Lifetime:"Lebensdauer","Free trial":"Kostenlose Testversion","/yr":"/Jahr","\u201cDo not save what is left after spending; spend what is left after saving.\u201d Warren Buffett":"\u201eSparen Sie nicht, was nach dem Ausgeben \xfcbrig bleibt; geben Sie aus, was nach dem Sparen \xfcbrig bleibt.\u201c Warren Buffett","\u201cKnow what you own, and know why you own it.\u201d Peter Lynch":"\u201eWissen Sie, was Sie besitzen, und wissen Sie, warum Sie es besitzen.\u201c Peter Lynch","\u201cYou must gain control over your money or the lack of it will forever control you.\u201d Dave Ramsey":"\u201eSie m\xfcssen die Kontrolle \xfcber Ihr Geld erlangen, sonst wird der Mangel an Geld Sie f\xfcr immer kontrollieren.\u201c Dave Ramsey",languageEnglish:"SpracheEnglisch","\u201cA big part of financial freedom is having your heart and mind free from worry about the what-ifs of life.\u201d Suze Orman":"\u201eEin gro\xdfer Teil der finanziellen Freiheit besteht darin, dass man sich mit Herz und Verstand keine Gedanken \xfcber die Was-w\xe4re-wenn des Lebens machen muss.\u201c Suze Orman","/mo":"/Mo","Billed monthly":"Wird monatlich abgerechnet","Try for free":"Kostenlos testen","One-time purchase":"Einmaliger Kauf",Then:"Dann","\u201cPennies do not come from heaven. They have to be earned here on earth.\u201d Margaret Thatcher":"\u201ePennys kommen nicht vom Himmel. Sie m\xfcssen hier auf der Erde verdient werden.\u201c Margaret Thatcher","\u201cIt's not how much money you make, but how much money you keep, how hard it works for you, and how many generations you keep it for.\u201d Robert Kiyosaki":"\u201eEs kommt nicht darauf an, wie viel Geld Sie verdienen, sondern darauf, wie viel Geld Sie behalten, wie hart es f\xfcr Sie arbeitet und f\xfcr wie viele Generationen Sie es behalten.\u201c Robert Kiyosaki","Billed yearly":"J\xe4hrliche Abrechnung",Classic:"Klassiker","Save {{percent}}%":"Sparen Sie {{percent}} \u200b\u200b%","The original Almi look":"Der urspr\xfcngliche Almi-Look","Could not finish the purchase. Please try again.":"Der Kauf konnte nicht abgeschlossen werden. Bitte versuchen Sie es erneut.","Could not restore purchases.":"Eink\xe4ufe konnten nicht wiederhergestellt werden.",Forest:"Wald",Sunny:"Sonnig",Lavender:"Lavendel","Purchase is unavailable: package was not found in store offerings.":"Der Kauf ist nicht verf\xfcgbar: Das Paket wurde in den Shop-Angeboten nicht gefunden.","Missing EXPO_PUBLIC_RC_ANDROID_API_KEY. Add it to Expo Environment Variables (preview/production), rebuild the app, and try again.":"EXPO_PUBLIC_RC_ANDROID_API_KEY fehlt. F\xfcgen Sie es zu den Expo-Umgebungsvariablen (Vorschau/Produktion) hinzu, erstellen Sie die App neu und versuchen Sie es erneut.","Bright and energising":"Hell und anregend","Teal breeze":"Blaugr\xfcne Brise",Indigo:"Indigo","Ocean breeze palette":"Meeresbrise-Palette",Sunset:"Sonnenuntergang","Mint explorer":"M\xfcnzforscher",Emerald:"Smaragd",Sunday:"Sonntag",Gold:"Gold",Wednesday:"Mittwoch",Tuesday:"Dienstag",Monday:"Montag",Aqua:"Aqua","No active subscription was found. Verify your Sandbox Apple ID and try again.":"Es wurde kein aktives Abonnement gefunden. \xdcberpr\xfcfen Sie Ihre Sandbox-Apple-ID und versuchen Sie es erneut.","No active subscription was found. Verify your Google Play test account and try again.":"Es wurde kein aktives Abonnement gefunden. \xdcberpr\xfcfen Sie Ihr Google Play-Testkonto und versuchen Sie es erneut.",Violet:"Violett",Friday:"Freitag",Thursday:"Donnerstag",Saturday:"Samstag","Balanced mode":"Ausgewogener Modus","0 coins":"0 M\xfcnzen","A dreamy violet vibe":"Eine vertr\xe4umte violette Atmosph\xe4re","A tiny step today protects tomorrow\u2019s plan.":"Ein kleiner Schritt heute sch\xfctzt den Plan von morgen.","Balance reinforced with another skip.":"Balance durch einen weiteren Sprung verst\xe4rkt.","Balance holds steady-keep logging the wins.":"Das Gleichgewicht bleibt stabil und protokolliert weiterhin die Siege.","Calm mode celebrates each milestone.":"Der Ruhemodus feiert jeden Meilenstein.","Staying calm even when urges spike.":"Bleiben Sie ruhig, auch wenn der Drang zunimmt.","Balance check-in \ud83d\ude3a":"Guthaben-Check-in \ud83d\ude3a","Balance alert \ud83d\ude3a":"Saldo-Alarm \ud83d\ude3a","Power mode: lock in one more proof of discipline.":"Power-Modus: Sichern Sie sich einen weiteren Disziplinarbeweis.","Focused mode speaking-decide what to do with \u201c{{title}}\u201d. \ud83d\udcaa":"Fokussiertes Sprechen \u2013 entscheiden Sie, was mit \u201e{{title}}\u201c geschehen soll. \ud83d\udcaa","Focused mode + goal complete! Time to plan even bigger.":"Fokussierter Modus + Ziel erreicht! Zeit, noch gr\xf6\xdfer zu planen.","Focused mode is on-temptations get nervous.":"Der Fokussierungsmodus ist auf Versuchungen ausgerichtet, nerv\xf6s zu werden.","\u201c{{title}}\u201d is waiting. Decide if it fits the plan. \ud83e\udded":"\u201e{{title}}\u201c wartet. Entscheiden Sie, ob es zum Plan passt. \ud83e\udded","Willpower locked in. Keep it going!":"Willenskraft eingeschlossen. Weiter so!","Focused mode crushes impulse spikes.":"Der fokussierte Modus unterdr\xfcckt Impulsspitzen.","Focused ping \ud83d\ude3c":"Konzentrierter Ping \ud83d\ude3c","Focused mode":"Fokussierter Modus","Focused alert \ud83d\ude3c":"Konzentrierter Alarm \ud83d\ude3c","Impulse paused-you took the controls back.":"Impuls pausierte \u2013 Sie \xfcbernahmen die Kontrolle zur\xfcck.","Impulse mode detected-time to capture a few wins.":"Impulsmodus erkannt \u2013 Zeit, ein paar Siege zu erringen.","Impulses were strong, yet you still hit the target.":"Die Impulse waren stark und trotzdem hast du das Ziel erreicht.","This hour begs for {{temptation}}, but focused mode can stash {{amount}}. \ud83c\udfe6":"Diese Stunde schreit nach {{temptation}}, aber der fokussierte Modus kann {{amount}} verstecken. \ud83c\udfe6","This hour usually tempts {{temptation}}, but balance can bank {{amount}}. \ud83d\udca7":"Diese Stunde lockt normalerweise {{temptation}}, aber der Rest kann {{amount}} \xfcberbr\xfccken. \ud83d\udca7","One tiny skip right now resets control.":"Ein winziger Sprung setzt die Kontrolle zur\xfcck.","Catch the next urge and reroute it into savings.":"Ergreifen Sie den n\xe4chsten Drang und leiten Sie ihn in Ersparnisse um.","Impulse incoming \ud83d\ude40":"Impuls kommt \ud83d\ude40","Impulse mode":"Impulsmodus","Doubter mode":"Zweiflermodus","Impulse check-in \ud83d\ude40":"Impuls-Check-in \ud83d\ude40","{{temptation}} usually wins now. Try sending {{amount}} to savings instead. \ud83e\uddf2":"{{temptation}} \u200b\u200bgewinnt jetzt normalerweise. Versuchen Sie stattdessen, {{amount}} an die Sparkasse zu senden. \ud83e\uddf2","Impulse mode needs clarity: keep \u201c{{title}}\u201d or bank it? \ud83d\udd25":"Der Impulsmodus braucht Klarheit: \u201e{{title}}\u201c behalten oder auf Bank setzen? \ud83d\udd25","When {{temptation}} calls, redirect {{amount}} to savings to regain certainty. \ud83e\udded":"Wenn {{temptation}} \u200b\u200banruft, leiten Sie {{amount}} zu den Ersparnissen um, um wieder Gewissheit zu erlangen. \ud83e\udded","Feeling unsure? \ud83d\ude3f":"F\xfchlen Sie sich unsicher? \ud83d\ude3f","Doubter check \ud83d\ude3f":"Zweifler-Check \ud83d\ude3f","Recharge mode":"Auflademodus","Pick one \u201csave it\u201d thought and lock it in.":"W\xe4hlen Sie einen \u201eSpeichern\u201c-Gedanken aus und merken Sie ihn sich.","\u201c{{title}}\u201d is stuck in limbo. Decide where it belongs. \ud83e\udde9":"\u201e{{title}}\u201c steckt in der Schwebe. Entscheiden Sie, wo es hingeh\xf6rt. \ud83e\udde9","That choice dissolves doubts.":"Diese Wahl zerstreut Zweifel.","Doubter mode is on-choose one confident move.":"Der Zweiflermodus ist aktiviert \u2013 w\xe4hlen Sie einen selbstbewussten Zug.","Doubts aside, goals still get reached. The course works.":"Zweifel beiseite, Ziele werden trotzdem erreicht. Der Kurs funktioniert.","Turn doubts into numbers, not purchases.":"Verwandeln Sie Zweifel in Zahlen, nicht in K\xe4ufe.","Start with one skip today and see the shift.":"Beginnen Sie noch heute mit einem Sprung und erleben Sie die Ver\xe4nderung.","Recharge mode isn\u2019t forever. Decide what to do with \u201c{{title}}\u201d. \ud83e\udef6":"Der Auflademodus ist nicht f\xfcr immer g\xfcltig. Entscheiden Sie, was mit \u201e{{title}}\u201c geschehen soll. \ud83e\udef6","There\u2019s the gentle restart. Nice.":"Da ist der sanfte Neustart. H\xfcbsch.","Come back to \u201c{{title}}\u201d \ud83d\ude3d\ud83d\udca4":"Kommen Sie zur\xfcck zu \u201e{{title}}\u201c \ud83d\ude3d\ud83d\udca4","Dreamer mode":"Tr\xe4umermodus","Gentle alert \ud83d\ude3d\ud83d\udca4":"Sanfte Warnung \ud83d\ude3d\ud83d\udca4","Breaks are part of the path. Return when ready.":"Pausen geh\xf6ren zum Weg. R\xfcckkehr, wenn Sie fertig sind.","Dreamer mode is on-your Thinking shelf is a gallery.":"Der Tr\xe4umer-Modus ist auf Ihrem Denkregal eine Galerie.","Breaks ran long, yet this minute can still save {{amount}} from {{temptation}}. \ud83d\udcab":"Die Pausen dauerten lange, doch diese Minute kann {{amount}} \u200b\u200bvor {{temptation}} retten. \ud83d\udcab","Long time no see-recharge mode suggests a gentle restart.":"Lange Zeit nicht sichtbar \u2013 Auflademodus deutet auf einen sanften Neustart hin.",Berries:"Beeren","Rested-you can say \u201clater\u201d with ease.":"Ausgeruht k\xf6nnen Sie problemlos \u201esp\xe4ter\u201c sagen.",Fish:"Fisch",Sushi:"Sushi",Yarn:"Garn","Even dreamers finish their plans.":"Sogar Tr\xe4umer bringen ihre Pl\xe4ne zu Ende.",Dessert:"Nachtisch","Let dreams live in numbers, not expenses.":"Lassen Sie Tr\xe4ume in Zahlen leben, nicht in Ausgaben.","Dream locked in with a real action.":"Ein Traum, verbunden mit einer echten Aktion.","Pick one dream and tap \u201csave it\u201d today.":"W\xe4hlen Sie einen Traum aus und tippen Sie noch heute auf \u201eSpeichern\u201c.","Add {{amount}} to the dream instead of grabbing {{temptation}} again. \ud83c\udf1f":"F\xfcgen Sie {{amount}} \u200b\u200bzum Traum hinzu, anstatt {{temptation}} erneut zu ergreifen. \ud83c\udf1f",Feather:"Feder","Thinking is crowded. Decide what to do with \u201c{{title}}\u201d. \ud83c\udf08":"Das Denken ist \xfcberf\xfcllt. Entscheiden Sie, was mit \u201e{{title}}\u201c geschehen soll. \ud83c\udf08","Dreams are waiting \ud83d\ude3b":"Tr\xe4ume warten \ud83d\ude3b","Dreamer alert \ud83d\ude3b":"Tr\xe4umer-Alarm \ud83d\ude3b",Laser:"Laser","Massage brush":"Massageb\xfcrste",Food:"Essen",Rent:"Mieten",Utilities:"Dienstprogramme",Car:"Auto",Home:"Heim",Transport:"Transport",Health:"Gesundheit",Beauty:"Sch\xf6nheit",Entertainment:"Unterhaltung",Shopping:"Einkaufen",Education:"Ausbildung",Clothing:"Kleidung",Subscriptions:"Abonnements",Pets:"Haustiere",Savings:"Ersparnisse","Toy mouse":"Spielzeugmaus","Foam soap":"Schaumseife","Mandatory payments":"Obligatorische Zahlungen","Bubbly soap":"Sprudelnde Seife","Soft brush":"Weiche B\xfcrste",Mon:"Mo",Wed:"Heiraten",Tue:"Di",Fri:"Fr",Thu:"Do",Sat:"Sa",d:"D","Quit smoking":"H\xf6ren Sie auf zu rauchen","Small vices":"Kleine Laster","Every skipped cigarette keeps the budget sharp.":"Jede ausgelassene Zigarette h\xe4lt das Budget knapp.","Goal one: slow down the take-away coffee habit.":"Ziel eins: Den Kaffeekonsum zum Mitnehmen verlangsamen.","Every skipped cup adds +{{amount}} to the stash.":"Jeder \xfcbersprungene Becher erh\xf6ht den Vorrat um +{{amount}}.","Sweet little impulse every morning.":"S\xfc\xdfer kleiner Impuls jeden Morgen.",Sun:"Sonne","First tier: fewer casual cigarettes and smoke breaks.":"Erste Stufe: weniger Gelegenheitszigaretten und Rauchpausen.","Coffee devotee":"Kaffeeliebhaber","My impulse":"Mein Impuls","Goal reached. Keep this momentum.":"Ziel erreicht. Behalten Sie diesen Schwung bei.","Pack of cigarettes":"Packung Zigaretten","Coffee run":"Kaffeelauf","Skip the smoke break, speed up the progress.":"\xdcberspringen Sie die Rauchpause und beschleunigen Sie den Fortschritt.","Keep beauty splurges and subs in check.":"Halten Sie Sch\xf6nheitsspritzer und Subs im Zaum.",Gamer:"Spieler","Beauty fan":"Beauty-Fan","One skipped beauty drop = {{amount}} toward the big goal.":"Ein \xfcbersprungener Sch\xf6nheitstropfen = {{amount}} \u200b\u200bauf dem Weg zum gro\xdfen Ziel.","Shadow, lipstick and yet another \u201cneeded\u201d serum.":"Schatten, Lippenstift und noch ein weiteres \u201enotwendiges\u201c Serum.","Skip delivery, unlock {{amount}} for real goals.":"\xdcberspringen Sie die Lieferung und schalten Sie {{amount}} \u200b\u200bfrei, um echte Ziele zu erreichen.","Skip a couple skins, gain momentum.":"\xdcberspringen Sie ein paar Skins und gewinnen Sie Schwung.","Mission one: fewer random delivery orders.":"Mission eins: weniger zuf\xe4llige Lieferauftr\xe4ge.","Cool down loot boxes, microtransactions and DLC binges.":"K\xfchlen Sie Lootboxen, Mikrotransaktionen und DLC-Binges ab.","Every skipped microtransaction frees {{amount}} for IRL goals.":"Jede \xfcbersprungene Mikrotransaktion gibt {{amount}} \u200b\u200bf\xfcr IRL-Ziele frei.","Game microtransaction":"Mikrotransaktion im Spiel","Mini beauty haul":"Mini-Sch\xf6nheitstransport","Delivery lover":"Lieferliebhaber","Pizza, poke or sushi? You choose progress.":"Pizza, Poke oder Sushi? Sie entscheiden sich f\xfcr den Fortschritt.","Every skipped checkout moves {{amount}} closer to your goal.":"Jeder \xfcbersprungene Checkout bringt {{amount}} \u200b\u200bIhrem Ziel n\xe4her.","Loves impulse online buys. Park them in a list instead of checkout.":"Liebt spontane Online-K\xe4ufe. Parken Sie sie in einer Liste statt zur Kasse.","Another package that could have been progress.":"Ein weiteres Paket, das ein Fortschritt h\xe4tte sein k\xf6nnen.","Every skipped home pick adds {{amount}} toward the goal.":"Jeder \xfcbersprungene Home-Pick erh\xf6ht den Zielwert um {{amount}}.","Main goal: fewer impulse home-decor buys.":"Hauptziel: weniger Impulsk\xe4ufe f\xfcr Wohnaccessoires.","Vase, candle or pillow - decide mindfully.":"Vase, Kerze oder Kissen \u2013 entscheiden Sie mit Bedacht.","Home decor pick":"Auswahl an Wohnaccessoires","Night delivery":"Nachtzustellung","Online shopper":"Online-K\xe4ufer","Online impulse":"Online-Impuls","Home picks":"Home-Tipps","Skipped the next merch drop-{{amount}} to your dream.":"Den n\xe4chsten Merch-Drop \xfcbersprungen-{{amount}} \u200b\u200bzu deinem Traum.","Fashion lover":"Modeliebhaber","Anime fan":"Anime-Fan","Subscription lover":"Abo-Liebhaber","Extra subscription":"Zus\xe4tzliches Abonnement","Anime merch":"Anime-Merch","Merch, manga, figures. Log only what truly matters.":"Merch, Manga, Figuren. Protokollieren Sie nur das, was wirklich wichtig ist.","Cancel the extra sub-{{amount}} stays with your goals.":"Stornieren Sie die zus\xe4tzlichen Sub-{{amount}} \u200b\u200bAufenthalte mit Ihren Zielen.","Streaming, SaaS, extra features. Keep subs under control.":"Streaming, SaaS, zus\xe4tzliche Funktionen. Behalten Sie U-Boote unter Kontrolle.","Monthly payments quietly draining the budget.":"Monatliche Zahlungen belasten stillschweigend das Budget.","Figure, volume, or keychain-choose mindfully.":"Figur, Lautst\xe4rke oder Schl\xfcsselanh\xe4nger \u2013 w\xe4hlen Sie mit Bedacht aus.","Spontaneous salon day":"Spontaner Salontag","Budget beauty dupe":"Budget-Sch\xf6nheitsbetr\xfcger","Impulse fashion pick":"Impulsive Modeauswahl","Every unsnapped drop adds {{amount}} to the big plan.":"Jeder ungeschnappte Tropfen f\xfcgt {{amount}} \u200b\u200bzum gro\xdfen Plan hinzu.","A \"luxury lookalike\" from the drugstore that could go straight to savings.":"Ein \u201eLuxus-Doppelg\xe4nger\u201c aus der Drogerie, mit dem man direkt sparen k\xf6nnte.","Scented candle":"Duftkerze","Wall art":"Wandkunst","Mani or facial \"just because.\" Swap the receipt for progress instead.":"Mani oder Gesichtsbehandlung \u201eeinfach so.\u201c Tauschen Sie stattdessen die Quittung gegen den Fortschritt aus.","A cozy ritual that can wait.":"Ein gem\xfctliches Ritual, das warten kann.","Another cute set, or a step toward your goal.":"Ein weiteres s\xfc\xdfes Set oder ein Schritt in Richtung Ihres Ziels.","Tracks drops and sales. Time to slow the impulses.":"Verfolgt Drops und Verk\xe4ufe. Zeit, die Impulse zu verlangsamen.","Bag, hoodie or sneakers-log it, don't grab it.":"Tasche, Kapuzenpullover oder Sneakers \u2013 protokollieren Sie es, schnappen Sie es sich nicht.",Male:"M\xe4nnlich",Female:"Weiblich","Prefer not to say":"Sag es lieber nicht",Travel:"Reisen","Tech upgrade":"Tech-Upgrade","Cleansing brush, LED mask or device that can wait for the big goal.":"Reinigungsb\xfcrste, LED-Maske oder Ger\xe4t, das auf das gro\xdfe Ziel warten kann.","Throw pillows":"Kissen werfen","At-home beauty gadget":"Beauty-Gadget f\xfcr zu Hause",language_en_selected:"language_en_selected","That new aesthetic can wait for the bigger goal.":"Diese neue \xc4sthetik kann auf das gr\xf6\xdfere Ziel warten.","Rainy-day fund":"Regenfallfonds","Closer to goal":"N\xe4her am Ziel","Tap the handle":"Tippen Sie auf den Griff","Daily treats":"T\xe4gliche Leckereien","I love nice things, but I love my money plan even more":"Ich liebe sch\xf6ne Dinge, aber noch mehr liebe ich meinen Geldplan","Matcha latte":"Matcha-Latte","Tiny daily swipe that quietly eats the budget if you don\u2019t watch it.":"Winziger t\xe4glicher Seitenhieb, der stillschweigend das Budget verschlingt, wenn Sie ihn nicht ansehen.","Glass cup + topping = nearly a gym pass per month if you bank it.":"Glasbecher + Topping = fast ein Fitnessstudio-Pass pro Monat, wenn man es auf die Bank bringt.","A small monthly subscription that quietly drains the budget.":"Ein kleines monatliches Abonnement, das das Budget stillschweigend aufzehrt.","A tiny treat that becomes a big level boost once you skip it.":"Ein kleiner Leckerbissen, der zu einem gro\xdfen Level-Boost wird, wenn man ihn \xfcberspringt.","Netflix subscription":"Netflix-Abonnement","Coffee to-go":"Kaffee zum Mitnehmen","Steps left to reach it":"Es bleiben nur noch wenige Schritte, um dorthin zu gelangen","Goal is within reach!":"Das Ziel ist zum Greifen nah!","Shiny dual-camera flagship tempting every scroll. Is the hype worth your savings?":"Gl\xe4nzendes Dual-Kamera-Flaggschiff, das jeden Scroller verf\xfchrt. Ist der Hype Ihre Ersparnisse wert?","Morning croissant":"Morgencroissant","New smartphone":"Neues Smartphone","Limited sneakers":"Limitierte Sneaker","Premium watch":"Premium \u200b\u200bansehen","Game console":"Spielekonsole","Rare drop everyone chases. Maybe the real flex is topping up your stash.":"Seltener Tropfen, den jeder verfolgt. Vielleicht liegt der eigentliche Vorteil darin, Ihren Vorrat aufzuf\xfcllen.","Tracks your pulse and spending if you resist wearing it daily.":"Verfolgt Ihren Puls und Ihre Ausgaben, wenn Sie sich weigern, es t\xe4glich zu tragen.","Saves worlds at night and your budget if you pause before checkout.":"Spart nachts Welten und Ihr Budget, wenn Sie vor dem Bezahlen eine Pause einlegen.","Tiny add-on in the cart that silently pushes the total over the top.":"Winziges Add-on im Einkaufswagen, das die Summe lautlos in die H\xf6he treibt.","Tickets, popcorn and soda that could become a little boost to savings.":"Tickets, Popcorn und Limonade, die ein kleiner Sparschub sein k\xf6nnten.","A couple of rounds on autopilot. Pause once and claim the win.":"Ein paar Runden auf Autopilot. Einmal pausieren und den Sieg einfahren.","Heat and AC at full blast make the bill climb quietly.":"Hitze und Klimaanlage auf Hochtouren lassen die Rechnung leise steigen.","Pizza & rolls night":"Pizza- und Br\xf6tchenabend","Cocktail night":"Cocktailabend","Extra sushi add-on":"Zus\xe4tzliches Sushi-Add-on","Movie night combo":"Filmabend-Kombination","Friday ritual that quickly becomes a $40 habit. Maybe cook tonight?":"Freitagsritual, das schnell zu einer 40-Dollar-Gewohnheit wird. Vielleicht heute Abend kochen?","A curated surprise box that steals a chunk of the monthly plan.":"Eine kuratierte \xdcberraschungsbox, die einen Teil des Monatsplans stiehlt.","Premium grooming bundle":"Premium \u200b\u200bPflegepaket","Fresh fitness band":"Frisches Fitnessband","Monthly beauty box":"Monatliche Beauty-Box","Pet spa day":"Haustier-Spa-Tag","Comfort-first utilities":"Komfort-First-Dienstprogramme","Grooming, toys and treats are cute, but goals can wait less.":"Pflege, Spielzeug und Leckereien sind s\xfc\xdf, aber Ziele k\xf6nnen weniger warten.","Razor, oils and trimmer that could become goal progress instead.":"Rasierer, \xd6le und Trimmer, die stattdessen zum Ziel des Fortschritts werden k\xf6nnten.","Bigger screen, more sensors and one more reason to pause the upgrade.":"Gr\xf6\xdferer Bildschirm, mehr Sensoren und ein Grund mehr, das Upgrade zu pausieren.","Weekend brunch ritual":"Brunch-Ritual am Wochenende","Insurance renewal":"Versicherungsverl\xe4ngerung","A skills upgrade that\u2019s great, but can wait while you save.":"Ein F\xe4higkeits-Upgrade, das gro\xdfartig ist, aber beim Speichern warten kann.","A required payment that can feel lighter when you check the options.":"Eine erforderliche Zahlung, die leichter erscheinen kann, wenn Sie die Optionen pr\xfcfen.","A shiny class pack that pays off only if the jar stays priority.":"Ein gl\xe4nzendes Klassenpaket, das sich nur auszahlt, wenn das Glas Priorit\xe4t beh\xe4lt.","Hoodie, cap and trinkets that could accelerate the bigger dream.":"Hoodie, M\xfctze und Schmuckst\xfccke, die den gr\xf6\xdferen Traum beschleunigen k\xf6nnten.","Stacks of pancakes and mimosas that could have been goal progress.":"Stapelweise Pfannkuchen und Mimosen, die ein Fortschritt h\xe4tten sein k\xf6nnen.","Spontaneous seaside flights before payday or a mindful trip later.":"Spontane Fl\xfcge ans Meer vor dem Zahltag oder eine achtsame Reise sp\xe4ter.","Streetwear capsule":"Streetwear-Kapsel","10-class studio pass":"10-Klassen-Studiopass","Flash vacation":"Flash-Urlaub","Online course bundle":"Online-Kurspaket","Designer bag":"Designer-Tasche","Dream road trip":"Traum-Roadtrip","Home coffee setup":"Kaffee-Setup f\xfcr zu Hause","Weekend city escape":"Wochenendausflug in die Stadt","Dream car":"Traumauto","Fuel, van life and freedom are all waiting once the progress bar hits max.":"Kraftstoff, Transporterleben und Freiheit warten auf Sie, sobald der Fortschrittsbalken das Maximum erreicht.","Two days of architecture and espresso or a month of savings momentum.":"Zwei Tage Architektur und Espresso oder ein Monat Sparschwung.","Every \u201csave it\u201d reroutes fuel from impulse chats into the future garage.":"Jedes \u201eSpeichern\u201c leitet Kraftstoff aus Impulsgespr\xe4chen in die zuk\xfcnftige Garage um.","Barista on the countertop and fewer pricey coffee runs.":"Barista auf der Arbeitsplatte und weniger teure Kaffeeausgaben.","Statement piece that either inspires or reminds you of bigger goals.":"Statement-St\xfcck, das Sie entweder inspiriert oder an gr\xf6\xdfere Ziele erinnert.","Every skipped delivery becomes a brick in your future address.":"Jede \xfcbersprungene Lieferung wird zu einem Baustein Ihrer zuk\xfcnftigen Adresse.","Pure gamification: the jet tier proves your discipline is first class.":"Gamification pur: Der Jet-Tier beweist, dass Ihre Disziplin erstklassig ist.","Private jet (why not)":"Privatjet (warum nicht)","Home down payment":"Anzahlung f\xfcr das Haus","Rent upgrade":"Mieterh\xf6hung","More space and light sound great, but you can prep for it without stress.":"Mehr Platz und Licht klingen gro\xdfartig, aber Sie k\xf6nnen sich stressfrei darauf vorbereiten.","Great start. With Premium, you can save up to {{percent}}% more over the next {{days}} days.":"Toller Anfang. Mit Premium k\xf6nnen Sie in den n\xe4chsten {{days}} Tagen bis zu {{percent}} \u200b\u200b% mehr sparen.","In the last {{days}} days, you could have saved {{amount}} more.":"In den letzten {{days}} \u200b\u200bTagen h\xe4tten Sie {{amount}} mehr sparen k\xf6nnen.","This feature helps recover money that usually slips away unnoticed":"Diese Funktion hilft dabei, Geld zur\xfcckzugewinnen, das normalerweise unbemerkt verloren geht","You are already saving. But {{amount}} over {{days}} days could still be kept.":"Sie sparen bereits. Aber {{amount}} \u200b\u200b\xfcber {{days}} Tage konnten immer noch gehalten werden.","Smart budget analytics with category limits":"Intelligente Budgetanalyse mit Kategoriebeschr\xe4nkungen","Impulse map with trigger and slip-zone insights":"Impulskarte mit Trigger- und Slip-Zone-Einblicken","Home screen widgets and slider":"Widgets und Schieberegler f\xfcr den Startbildschirm","More challenges and rewards":"Mehr Herausforderungen und Belohnungen","Unlimited custom categories":"Unbegrenzte benutzerdefinierte Kategorien","Instant unlock of all level-gated features":"Sofortige Freischaltung aller Level-Gate-Funktionen","Unlimited temptation cards":"Unbegrenzte Versuchungskarten","Weekly and monthly smart spending analysis with insights":"W\xf6chentliche und monatliche Smart-Spending-Analyse mit Einblicken","Cat customization + full Pro theme customization":"Katzenanpassung + vollst\xe4ndige Pro-Theme-Anpassung","Unlimited goals":"Unbegrenzte Ziele","smart spending analysis":"Intelligente Ausgabenanalyse","impulse map":"Impulskarte","Extended Think queue":"Erweiterte Think-Warteschlange","multiple goals":"mehrere Ziele","smart budget analytics":"Intelligente Budgetanalyse","widget slider":"Widget-Schieberegler","custom categories":"benutzerdefinierte Kategorien","more Think cards":"weitere Think-Karten","home widget":"Home-Widget","cat customization":"Katzenanpassung","full history":"vollst\xe4ndige Geschichte","extra temptation cards":"zus\xe4tzliche Versuchungskarten","more challenge claims":"weitere Anfechtungsanspr\xfcche","Premium costs the price of a single impulse you choose to skip.":"Premium \u200b\u200bkostet den Preis eines einzelnen Impulses, den Sie \xfcberspringen m\xf6chten.","Now is the best moment to set your spending system: limits, reports, and control from day one.":"Jetzt ist der beste Zeitpunkt, Ihr Ausgabensystem festzulegen: Limits, Berichte und Kontrolle vom ersten Tag an.","Premium is {{monthly}}. With the full toolkit, you can recover up to {{amount}} over the next {{days}} days.":"Premium ist {{monthly}}. Mit dem vollst\xe4ndigen Toolkit k\xf6nnen Sie in den n\xe4chsten {{days}} Tagen bis zu {{amount}} wiederherstellen.","Premium helps lock in your spending-control habit from day one.":"Premium \u200b\u200bhilft Ihnen dabei, Ihre Ausgabenkontrollgewohnheit vom ersten Tag an zu festigen.",FREE:"FREI","full Pro theme customization":"vollst\xe4ndige Anpassung des Pro-Themes","Almost has already helped you save {{saved}}. Premium closes remaining leaks and keeps momentum going.":"Almost hat Ihnen bereits beim Speichern von {{saved}} \u200b\u200bgeholfen. Premium schlie\xdft verbleibende Lecks und h\xe4lt die Dynamik aufrecht.",PRO:"PRO",Unavailable:"Nicht verf\xfcgbar","Premium instantly unlocks all features gated by user levels.":"Premium \u200b\u200bschaltet sofort alle durch Benutzerebenen begrenzten Funktionen frei.","Free includes 10 saves per day and resets at midnight. Premium unlocks unlimited entries.":"Kostenlos beinhaltet 10 Speicherungen pro Tag und Zur\xfccksetzen um Mitternacht. Premium \u200b\u200bschaltet unbegrenzte Eintr\xe4ge frei.","Unlock Premium for the full toolkit and keep more money every month.":"Schalten Sie Premium \u200b\u200bf\xfcr das komplette Toolkit frei und behalten Sie jeden Monat mehr Geld.","Unlock Premium to access {{featureName}} and get the full toolkit.":"Schalten Sie Premium frei, um auf {{featureName}} \u200b\u200bzuzugreifen und das vollst\xe4ndige Toolkit zu erhalten.","Entry limit reached.":"Eingabelimit erreicht.","https://www.notion.so/TERMS-OF-USE-EN-2b24e58ea9a0801292ead33eba50d02b?":"https://www.notion.so/TERMS-OF-USE-EN-2b24e58ea9a0801292ead33eba50d02b?","https://www.notion.so/PRIVACY-POLICY-EN-2b24e58ea9a08033abe7e038e63a2003":"https://www.notion.so/PRIVACY-POLICY-EN-2b24e58ea9a08033abe7e038e63a2003",Continue:"Weitermachen","Maybe later":"Vielleicht sp\xe4ter",Terms:"Bedingungen",Privacy:"Privatsph\xe4re","Manage subscription":"Abonnement verwalten","Select a plan and tap the button below":"W\xe4hlen Sie einen Plan aus und tippen Sie auf die Schaltfl\xe4che unten","Tap a feature to see its savings impact.":"Tippen Sie auf eine Funktion, um die Auswirkungen auf die Einsparungen zu sehen.","We store only the minimum profile data required to operate the app. You can edit or request deletion via settings and support, which wipes related history from our systems.":"Wir speichern nur die f\xfcr den Betrieb der App erforderlichen Mindestprofildaten. Sie k\xf6nnen \xfcber die Einstellungen und den Support eine Bearbeitung vornehmen oder eine L\xf6schung anfordern, wodurch der entsprechende Verlauf aus unseren Systemen gel\xf6scht wird.","Almost is a mindful spending companion, not a bank, broker, or financial advisor. Every decision about saving or spending remains your responsibility.":"Almost \u200b\u200bist ein aufmerksamer Begleiter beim Ausgeben, keine Bank, kein Makler oder Finanzberater. Jede Entscheidung \xfcber das Sparen oder Ausgeben liegt in Ihrer Verantwortung.","This agreement is governed by the laws of the jurisdiction where Almost is registered. Any dispute is settled amicably first and, if needed, in the courts of that jurisdiction.":"Diese Vereinbarung unterliegt den Gesetzen der Gerichtsbarkeit, in der Almost \u200b\u200bregistriert ist. Alle Streitigkeiten werden zun\xe4chst g\xfctlich und bei Bedarf vor den Gerichten der jeweiligen Gerichtsbarkeit beigelegt.","Choose your Premium plan":"W\xe4hlen Sie Ihren Premium \u200b\u200bPlan","Restore purchases":"Eink\xe4ufe wiederherstellen","You confirm that the information you share is accurate and voluntarily provided so Almost can personalise hints, notifications, and anonymised analytics.":"Sie best\xe4tigen, dass die von Ihnen weitergegebenen Informationen korrekt sind und freiwillig bereitgestellt werden, damit Almost \u200b\u200bHinweise, Benachrichtigungen und anonymisierte Analysen personalisieren kann.","Basic impulse tracker":"Basis-Impulstracker","Smart budget analytics and category limits":"Smarte Budgetanalyse und Kategorielimits","Weekly and monthly personal reports":"W\xf6chentliche und monatliche pers\xf6nliche Berichte","Impulse map: triggers and slip zones":"Impulskarte: Trigger und Risikozonen","Instant unlock of all level-gated tools":"Sofortiger Zugriff auf alle levelgesperrten Tools","Extended \u201cThink\u201d queue":"Erweiterte \u201eDenken\u201c-Warteschlange","Cat skins + Pro theme":"Katzen-Skins + Pro-Theme","Smart budget can protect {{amount}} in {{days}} days.":"Das smarte Budget kann in {{days}} Tagen {{amount}} sch\xfctzen.","Auto category limits reduce overspending before month-end.":"Automatische Kategorielimits reduzieren \xdcberausgaben vor Monatsende.","People who use personal reports and optimization tips save around 30% more on average.":"Menschen mit pers\xf6nlichen Berichten und Optimierungstipps sparen im Schnitt etwa 30 % mehr.","Reports give clear next steps based on your own categories and behavior.":"Berichte liefern klare n\xe4chste Schritte auf Basis deiner Kategorien und Gewohnheiten.","When money is split into multiple goals, impulse buys drop and progress accelerates.":"Wenn Geld auf mehrere Ziele verteilt ist, sinken Impulsk\xe4ufe und der Fortschritt beschleunigt sich.","Track several goals in parallel and keep motivation high.":"Verfolge mehrere Ziele parallel und halte die Motivation hoch.","Impulse map can recover {{amount}} in {{days}} days.":"Die Impulskarte kann in {{days}} Tagen {{amount}} zur\xfcckholen.","It shows when and where urges spike so you can stop overspending before checkout.":"Sie zeigt, wann und wo Impulse ansteigen, damit du \xdcberausgaben vor dem Checkout stoppst.","Challenge-driven routines improve discipline: active users typically keep more money in the first weeks.":"Challenge-Routinen st\xe4rken die Disziplin: Aktive Nutzer behalten in den ersten Wochen meist mehr Geld.","More challenges mean more checkpoints where spending gets interrupted.":"Mehr Challenges bedeuten mehr Kontrollpunkte, an denen Ausgaben gestoppt werden.","Without extra cards, small recurring leaks stay invisible.":"Ohne zus\xe4tzliche Karten bleiben kleine wiederkehrende Lecks unsichtbar.","Unlimited cards help you patch new spending leaks as soon as they appear.":"Unbegrenzte Karten helfen dir, neue Ausgabenlecks sofort zu schlie\xdfen.","Home widgets can protect {{amount}} in {{days}} days.":"Home-Widgets k\xf6nnen in {{days}} Tagen {{amount}} sch\xfctzen.","Users with home widgets save about 1.4x more money.":"Benutzer mit Home-Widgets sparen etwa 1,4x mehr Geld.","You see your limits before buying, so fewer purchases happen on autopilot.":"Du siehst deine Limits vor dem Kauf, dadurch passieren weniger Autopilot-K\xe4ufe.","While core tools stay locked behind levels, you miss savings that could add {{amount}} over {{days}} days.":"Solange Kern-Tools hinter Levels gesperrt sind, entgehen dir Einsparungen von {{amount}} in {{days}} Tagen.","Premium unlocks everything immediately.":"Premium schaltet alles sofort frei.","Custom categories make leaks obvious and can recover up to {{amount}} over {{days}} days.":"Benutzerdefinierte Kategorien machen Lecks sichtbar und k\xf6nnen in {{days}} Tagen bis zu {{amount}} zur\xfcckholen.","Better categories lead to more precise reports and recommendations.":"Bessere Kategorien f\xfchren zu pr\xe4ziseren Berichten und Empfehlungen.","Without a longer Think queue, impulse urges are harder to cool off in time.":"Ohne l\xe4ngere Denken-Warteschlange lassen sich Impulse schwerer rechtzeitig abk\xfchlen.","Delayed decisions create a pause that protects your budget.":"Verz\xf6gerte Entscheidungen schaffen eine Pause, die dein Budget sch\xfctzt.","Clarity streak":"Klarheitsserie","Log {{count}} impulse-free days in a row for a quick reset.":"Erfasse {{count}} impulsfreie Tage am St\xfcck f\xfcr einen schnellen Reset.","Decline sprint":"Ablehnungs-Sprint","Record {{count}} mindful refusals in a row to lock the habit.":"Protokolliere {{count}} achtsame Ablehnungen in Folge, um die Gewohnheit zu festigen.","Savings boost":"Spar-Boost","Route {{amount}} into savings through refusals this week.":"Leite diese Woche {{amount}} durch Ablehnungen in deine Ersparnisse.","Clear the shelf":"Regal leeren","Resolve {{count}} items from the thinking list and free up focus.":"Bearbeite {{count}} Eintr\xe4ge aus der Denken-Liste und schaffe Fokus.","Goal-mapping":"Ziel-Mapping","Add {{count}} new goals to remember why you save.":"F\xfcge {{count}} neue Ziele hinzu, um dich daran zu erinnern, warum du sparst.","Weekend shield":"Wochenend-Schutz","Log {{count}} refusals during the weekend rush.":"Protokolliere {{count}} Ablehnungen im Wochenend-Trubel.","Evening focus":"Abendfokus","Log a free day after 6pm {{count}} times.":"Protokolliere nach 18 Uhr {{count}}-mal einen ausgabenfreien Tag.","High-roller shield":"Schutz vor gro\xdfen Ausgaben","Decline {{count}} big spends (over {{limit}}) to stay on track.":"Lehne {{count}} gro\xdfe Ausgaben (\xfcber {{limit}}) ab, um auf Kurs zu bleiben.","Pause collector":"Pausen-Sammler","Park {{count}} temptations into \u201cdecide later\u201d to buy yourself time.":"Parke {{count}} Versuchungen in \u201esp\xe4ter entscheiden\u201c, um dir Zeit zu kaufen.","First {{amount}}":"Erste {{amount}}","{{amount}} saved already":"{{amount}} schon gespart","14 impulse-free days":"14 impulsfreie Tage","7-day streak":"7-Tage-Serie","Thinking stash":"Denken-Reservoir","Clear-headed":"Klarer Kopf","3 daily challenges":"3 t\xe4gliche Challenges","Focus \xd73":"Fokus \xd73","5 new temptations":"5 neue Versuchungen","Already banked {{amount}} for a mini gift.":"{{amount}} f\xfcr ein kleines Geschenk bereits zur\xfcckgelegt.","Time to plan for a bigger goal.":"Zeit, ein gr\xf6\xdferes Ziel zu planen.","Two solid weeks of mindful focus.":"Zwei starke Wochen mit achtsamem Fokus.","A full week in the mindful zone.":"Eine volle Woche im achtsamen Modus.","10 temptations parked in Thinking.":"10 Versuchungen in Denken geparkt.","Closed out 5 Thinking decisions with intent.":"5 Entscheidungen aus Denken bewusst abgeschlossen.","Complete 3 daily challenges to build momentum.":"Schlie\xdfe 3 t\xe4gliche Challenges ab, um Momentum aufzubauen.","Win 3 focus victories against a temptation.":"Gewinne 3 Fokus-Siege gegen eine Versuchung.","Add 5 new temptations to track.":"F\xfcge 5 neue Versuchungen zum Tracking hinzu."},ar:{en:"\u0623\u0648\u0646",English:"\u0625\u0646\u062c\u0644\u064a\u0632\u064a","en-US":"ar-US","\u201cWealth is the slave of a wise man and the master of a fool.\u201d Seneca":"\"\u0627\u0644\u062b\u0631\u0648\u0629 \u0639\u0628\u062f \u0627\u0644\u062d\u0643\u064a\u0645 \u0648\u0633\u064a\u062f \u0627\u0644\u0623\u062d\u0645\u0642.\" \u0633\u064a\u0646\u064a\u0643\u0627","\u201cA penny saved is a penny earned.\u201d Benjamin Franklin":"\"\u0627\u0644\u0641\u0644\u0633 \u0627\u0644\u0645\u062f\u062e\u0631 \u0647\u0648 \u0642\u0631\u0634 \u0645\u0643\u062a\u0633\u0628.\" \u0628\u0646\u064a\u0627\u0645\u064a\u0646 \u0641\u0631\u0627\u0646\u0643\u0644\u064a\u0646",Yearly:"\u0633\u0646\u0648\u064a",Monthly:"\u0634\u0647\u0631\u064a\u0627",Lifetime:"\u062d\u064a\u0627\u0629","\u201cYou must gain control over your money or the lack of it will forever control you.\u201d Dave Ramsey":"\"\u064a\u062c\u0628 \u0623\u0646 \u062a\u062a\u062d\u0643\u0645 \u0641\u064a \u0623\u0645\u0648\u0627\u0644\u0643 \u0648\u0625\u0644\u0627 \u0641\u0625\u0646 \u0627\u0644\u0627\u0641\u062a\u0642\u0627\u0631 \u0625\u0644\u064a\u0647\u0627 \u0633\u064a\u0633\u064a\u0637\u0631 \u0639\u0644\u064a\u0643 \u0625\u0644\u0649 \u0627\u0644\u0623\u0628\u062f.\" \u062f\u064a\u0641 \u0631\u0645\u0632\u064a","\u201cDo not save what is left after spending; spend what is left after saving.\u201d Warren Buffett":"\xab\u0644\u0627 \u062a\u062f\u062e\u0631 \u0645\u0627 \u0628\u0642\u064a \u0628\u0639\u062f \u0627\u0644\u0625\u0646\u0641\u0627\u0642\u060c \u0628\u0644 \u0623\u0646\u0641\u0642 \u0645\u0627 \u0628\u0642\u064a \u0628\u0639\u062f \u0627\u0644\u0627\u062f\u062e\u0627\u0631\xbb. \u0648\u0627\u0631\u0646 \u0628\u0627\u0641\u064a\u062a",languageEnglish:"languageEnglish","\u201cA big part of financial freedom is having your heart and mind free from worry about the what-ifs of life.\u201d Suze Orman":"\"\u062c\u0632\u0621 \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u062d\u0631\u064a\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0647\u0648 \u0623\u0646 \u064a\u062a\u062d\u0631\u0631 \u0642\u0644\u0628\u0643 \u0648\u0639\u0642\u0644\u0643 \u0645\u0646 \u0627\u0644\u0642\u0644\u0642 \u0628\u0634\u0623\u0646 \u0645\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u062d\u062f\u062b \u0641\u064a \u0627\u0644\u062d\u064a\u0627\u0629.\" \u0633\u0648\u0632\u064a \u0623\u0648\u0631\u0645\u0627\u0646",Premium:"Premium","\u201cNever spend your money before you have it.\u201d Thomas Jefferson":"\"\u0644\u0627 \u062a\u0646\u0641\u0642 \u0623\u0645\u0648\u0627\u0644\u0643 \u0642\u0628\u0644 \u0623\u0646 \u062a\u062d\u0635\u0644 \u0639\u0644\u064a\u0647\u0627.\" \u062a\u0648\u0645\u0627\u0633 \u062c\u064a\u0641\u0631\u0633\u0648\u0646","\u201cPennies do not come from heaven. They have to be earned here on earth.\u201d Margaret Thatcher":"\"\u0627\u0644\u0628\u0646\u0633\u0627\u062a \u0644\u0627 \u062a\u0623\u062a\u064a \u0645\u0646 \u0627\u0644\u0633\u0645\u0627\u0621. \u064a\u062c\u0628 \u0623\u0646 \u064a\u062a\u0645 \u0643\u0633\u0628\u0647\u0627 \u0647\u0646\u0627 \u0639\u0644\u0649 \u0627\u0644\u0623\u0631\u0636.\" \u0645\u0627\u0631\u063a\u0631\u064a\u062a \u062a\u0627\u062a\u0634\u0631","\u201cIt's not how much money you make, but how much money you keep, how hard it works for you, and how many generations you keep it for.\u201d Robert Kiyosaki":"\"\u0644\u0627 \u064a\u0647\u0645 \u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0645\u0627\u0644 \u0627\u0644\u0630\u064a \u062a\u062c\u0646\u064a\u0647\u060c \u0648\u0644\u0643\u0646 \u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0645\u0627\u0644 \u0627\u0644\u0630\u064a \u062a\u062d\u062a\u0641\u0638 \u0628\u0647\u060c \u0648\u0645\u062f\u0649 \u0635\u0639\u0648\u0628\u0629 \u0630\u0644\u0643 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0643\u060c \u0648\u0639\u062f\u062f \u0627\u0644\u0623\u062c\u064a\u0627\u0644 \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0641\u0638 \u0628\u0647\u0627\". \u0631\u0648\u0628\u0631\u062a \u0643\u064a\u0648\u0633\u0627\u0643\u064a","\u201cKnow what you own, and know why you own it.\u201d Peter Lynch":"\"\u0627\u0639\u0631\u0641 \u0645\u0627 \u062a\u0645\u0644\u0643\u0647\u060c \u0648\u0627\u0639\u0631\u0641 \u0644\u0645\u0627\u0630\u0627 \u062a\u0645\u0644\u0643\u0647.\" \u0628\u064a\u062a\u0631 \u0644\u064a\u0646\u0634","/mo":"/\u0634\u0647\u0631","Billed monthly":"\u062a\u062f\u0641\u0639 \u0634\u0647\u0631\u064a\u0627","Billed yearly":"\u064a\u062a\u0645 \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0633\u0646\u0648\u064a\u064b\u0627","One-time purchase":"\u0634\u0631\u0627\u0621 \u0644\u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629","Try for free":"\u062d\u0627\u0648\u0644 \u0645\u062c\u0627\u0646\u0627",Then:"\u062b\u0645","Free trial":"\u062a\u062c\u0631\u0628\u0629 \u0645\u062c\u0627\u0646\u064a\u0629","/yr":"/ \u0633\u0646\u0629","Save {{percent}}%":"\u062d\u0641\u0638 {{percent}}%",Classic:"\u0643\u0644\u0627\u0633\u064a\u0643\u064a","Mint explorer":"\u0645\u0633\u062a\u0643\u0634\u0641 \u0627\u0644\u0646\u0639\u0646\u0627\u0639",Forest:"\u063a\u0627\u0628\u0629","Could not restore purchases.":"\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a.","No active subscription was found. Verify your Sandbox Apple ID and try again.":"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0634\u062a\u0631\u0627\u0643 \u0646\u0634\u0637. \u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0639\u0631\u0641 Sandbox Apple \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0648\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.","Could not finish the purchase. Please try again.":"\u0644\u0627 \u064a\u0645\u0643\u0646 \u0625\u0643\u0645\u0627\u0644 \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u0634\u0631\u0627\u0621. \u064a\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",Sunny:"\u0645\u0634\u0645\u0633","The original Almi look":"\u0627\u0644\u0645\u0638\u0647\u0631 \u0627\u0644\u0623\u0635\u0644\u064a Almi","Ocean breeze palette":"\u0644\u0648\u062d\u0629 \u0646\u0633\u064a\u0645 \u0627\u0644\u0645\u062d\u064a\u0637","Teal breeze":"\u0646\u0633\u064a\u0645 \u0627\u0644\u0628\u0637 \u0627\u0644\u0628\u0631\u064a",Lavender:"\u0644\u0627\u0641\u0646\u062f\u0631",Indigo:"\u0646\u064a\u0644\u064a",Emerald:"\u0627\u0644\u0632\u0645\u0631\u062f","No active subscription was found. Verify your Google Play test account and try again.":"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0634\u062a\u0631\u0627\u0643 \u0646\u0634\u0637. \u062a\u062d\u0642\u0642 \u0645\u0646 \u062d\u0633\u0627\u0628\u0643 \u0627\u0644\u062a\u062c\u0631\u064a\u0628\u064a \u0639\u0644\u0649 Google Play \u0648\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.","Missing EXPO_PUBLIC_RC_ANDROID_API_KEY. Add it to Expo Environment Variables (preview/production), rebuild the app, and try again.":"EXPO_PUBLIC_RC_ANDROID_API_KEY \u0645\u0641\u0642\u0648\u062f. \u0623\u0636\u0641\u0647 \u0625\u0644\u0649 \u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0628\u064a\u0626\u0629 \u0627\u0644\u0645\u0639\u0631\u0636 (\u0627\u0644\u0645\u0639\u0627\u064a\u0646\u0629/\u0627\u0644\u0625\u0646\u062a\u0627\u062c)\u060c \u0648\u0623\u0639\u062f \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0648\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.","Purchase is unavailable: package was not found in store offerings.":"\u0627\u0644\u0634\u0631\u0627\u0621 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d: \u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u062d\u0632\u0645\u0629 \u0641\u064a \u0639\u0631\u0648\u0636 \u0627\u0644\u0645\u062a\u062c\u0631.",Sunset:"\u063a\u0631\u0648\u0628",Gold:"\u0630\u0647\u0628",Violet:"\u0627\u0644\u0628\u0646\u0641\u0633\u062c\u064a",Thursday:"\u064a\u0648\u0645 \u0627\u0644\u062e\u0645\u064a\u0633",Monday:"\u0627\u0644\u0627\u062b\u0646\u064a\u0646",Wednesday:"\u0627\u0644\u0623\u0631\u0628\u0639\u0627\u0621",Friday:"\u062c\u0645\u0639\u0629",Tuesday:"\u064a\u0648\u0645 \u0627\u0644\u062b\u0644\u0627\u062b\u0627\u0621","Bright and energising":"\u0645\u0634\u0631\u0642 \u0648\u062a\u0646\u0634\u064a\u0637","A dreamy violet vibe":"\u0623\u062c\u0648\u0627\u0621 \u0628\u0646\u0641\u0633\u062c\u064a\u0629 \u062d\u0627\u0644\u0645\u0629",Sunday:"\u0627\u0644\u0623\u062d\u062f",Saturday:"\u0627\u0644\u0633\u0628\u062a","0 coins":"0 \u0639\u0645\u0644\u0627\u062a \u0645\u0639\u062f\u0646\u064a\u0629","Balanced mode":"\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0645\u062a\u0648\u0627\u0632\u0646","Balance check-in \ud83d\ude3a":"\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0631\u0635\u064a\u062f \ud83d\ude3a",Aqua:"\u0623\u0643\u0648\u0627","Balance reinforced with another skip.":"\u062a\u0645 \u062a\u0639\u0632\u064a\u0632 \u0627\u0644\u062a\u0648\u0627\u0632\u0646 \u0628\u062a\u062e\u0637\u064a \u0622\u062e\u0631.","Staying calm even when urges spike.":"\u0627\u0644\u0628\u0642\u0627\u0621 \u0647\u0627\u062f\u0626\u064b\u0627 \u062d\u062a\u0649 \u0639\u0646\u062f\u0645\u0627 \u062a\u062d\u062b \u0639\u0644\u0649 \u0627\u0644\u0627\u0631\u062a\u0641\u0627\u0639.","Calm mode celebrates each milestone.":"\u064a\u062d\u062a\u0641\u0644 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0647\u0627\u062f\u0626 \u0628\u0643\u0644 \u0645\u0639\u0644\u0645.","Balance holds steady-keep logging the wins.":"\u0627\u0644\u062a\u0648\u0627\u0632\u0646 \u064a\u0638\u0644 \u062b\u0627\u0628\u062a\u064b\u0627 - \u0627\u0633\u062a\u0645\u0631 \u0641\u064a \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0627\u0646\u062a\u0635\u0627\u0631\u0627\u062a.","Balance alert \ud83d\ude3a":"\u062a\u0646\u0628\u064a\u0647 \u0627\u0644\u0631\u0635\u064a\u062f \ud83d\ude3a","Focused mode":"\u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0645\u0631\u0643\u0632","\u201c{{title}}\u201d is waiting. Decide if it fits the plan. \ud83e\udded":"\"{{title}}\" \u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631. \u0642\u0631\u0631 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u062a\u0646\u0627\u0633\u0628 \u0627\u0644\u062e\u0637\u0629. \ud83e\udded","Focused mode crushes impulse spikes.":"\u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u064a\u0633\u062d\u0642 \u0637\u0641\u0631\u0627\u062a \u0627\u0644\u0627\u0646\u062f\u0641\u0627\u0639.","Willpower locked in. Keep it going!":"\u0642\u0648\u0629 \u0627\u0644\u0625\u0631\u0627\u062f\u0629 \u0645\u063a\u0644\u0642\u0629. \u0627\u0633\u062a\u0645\u0631 \u0641\u064a \u0630\u0644\u0643!","Focused alert \ud83d\ude3c":"\u062a\u0646\u0628\u064a\u0647 \u0645\u0631\u0643\u0632 \ud83d\ude3c","A tiny step today protects tomorrow\u2019s plan.":"\u062e\u0637\u0648\u0629 \u0635\u063a\u064a\u0631\u0629 \u0627\u0644\u064a\u0648\u0645 \u062a\u062d\u0645\u064a \u062e\u0637\u0629 \u0627\u0644\u063a\u062f.","Focused mode is on-temptations get nervous.":"\u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0647\u0648 \u0623\u0646 \u062a\u0635\u0628\u062d \u0627\u0644\u0625\u063a\u0631\u0627\u0621\u0627\u062a \u0639\u0635\u0628\u064a\u0629.","Focused mode + goal complete! Time to plan even bigger.":"\u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 + \u0627\u0644\u0647\u062f\u0641 \u0643\u0627\u0645\u0644! \u062d\u0627\u0646 \u0627\u0644\u0648\u0642\u062a \u0644\u0644\u062a\u062e\u0637\u064a\u0637 \u0628\u0634\u0643\u0644 \u0623\u0643\u0628\u0631.","Power mode: lock in one more proof of discipline.":"\u0648\u0636\u0639 \u0627\u0644\u0637\u0627\u0642\u0629: \u0642\u0641\u0644 \u062f\u0644\u064a\u0644 \u0622\u062e\u0631 \u0639\u0644\u0649 \u0627\u0644\u0627\u0646\u0636\u0628\u0627\u0637.","Focused ping \ud83d\ude3c":"\u0627\u0644\u0628\u064a\u0646\u062c \u0627\u0644\u0645\u0631\u0643\u0632 \ud83d\ude3c","This hour usually tempts {{temptation}}, but balance can bank {{amount}}. \ud83d\udca7":"\u0639\u0627\u062f\u0629\u064b \u0645\u0627 \u062a\u063a\u0631\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0627\u0639\u0629 {{temptation}}\u060c \u0644\u0643\u0646 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0635\u0644 \u0627\u0644\u0631\u0635\u064a\u062f \u0625\u0644\u0649 {{amount}}. \ud83d\udca7","Focused mode speaking-decide what to do with \u201c{{title}}\u201d. \ud83d\udcaa":"\u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0639\u0644\u0649 \u0627\u0644\u062a\u062d\u062f\u062b - \u0642\u0631\u0631 \u0645\u0627 \u064a\u062c\u0628 \u0641\u0639\u0644\u0647 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \"{{title}}\". \ud83d\udcaa","Impulse paused-you took the controls back.":"\u062a\u0648\u0642\u0641 \u0627\u0644\u062f\u0627\u0641\u0639 \u0645\u0624\u0642\u062a\u064b\u0627 - \u0644\u0642\u062f \u0627\u0633\u062a\u0639\u062f\u062a \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u062d\u0643\u0645.","Impulse mode needs clarity: keep \u201c{{title}}\u201d or bank it? \ud83d\udd25":"\u064a\u062d\u062a\u0627\u062c \u0648\u0636\u0639 \u0627\u0644\u0627\u0646\u062f\u0641\u0627\u0639 \u0625\u0644\u0649 \u0627\u0644\u0648\u0636\u0648\u062d: \u0647\u0644 \u0627\u062d\u062a\u0641\u0638 \u0628\u0640 \"{{title}}\" \u0623\u0648 \u0642\u0645 \u0628\u062a\u062e\u0632\u064a\u0646\u0647\u061f \ud83d\udd25","Impulses were strong, yet you still hit the target.":"\u0643\u0627\u0646\u062a \u0627\u0644\u0646\u0628\u0636\u0627\u062a \u0642\u0648\u064a\u0629\u060c \u0648\u0645\u0639 \u0630\u0644\u0643 \u0641\u0642\u062f \u0623\u0635\u0627\u0628\u062a \u0627\u0644\u0647\u062f\u0641.","Impulse mode detected-time to capture a few wins.":"\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0648\u0636\u0639 \u0627\u0644\u0627\u0646\u062f\u0641\u0627\u0639 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u0627\u0644\u062a\u0642\u0627\u0637 \u0628\u0639\u0636 \u0627\u0644\u0627\u0646\u062a\u0635\u0627\u0631\u0627\u062a.","This hour begs for {{temptation}}, but focused mode can stash {{amount}}. \ud83c\udfe6":"\u062a\u062a\u0637\u0644\u0628 \u0647\u0630\u0647 \u0627\u0644\u0633\u0627\u0639\u0629 {{temptation}}\u060c \u0644\u0643\u0646 \u0627\u0644\u0648\u0636\u0639 \u0627\u0644\u0645\u0631\u0643\u0632 \u064a\u0645\u0643\u0646\u0647 \u062a\u062e\u0632\u064a\u0646 {{amount}}. \ud83c\udfe6","Impulse check-in \ud83d\ude40":"\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u0627\u0646\u062f\u0641\u0627\u0639\u064a \ud83d\ude40","Impulse mode":"\u0648\u0636\u0639 \u0627\u0644\u062f\u0627\u0641\u0639","Impulse incoming \ud83d\ude40":"\u062f\u0641\u0639\u0629 \u0648\u0627\u0631\u062f\u0629 \ud83d\ude40","Catch the next urge and reroute it into savings.":"\u0627\u062d\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0628\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0648\u0623\u0639\u062f \u062a\u0648\u062c\u064a\u0647\u0647\u0627 \u0625\u0644\u0649 \u0627\u0644\u0627\u062f\u062e\u0627\u0631.","One tiny skip right now resets control.":"\u062a\u062e\u0637\u064a \u0648\u0627\u062d\u062f \u0635\u063a\u064a\u0631 \u0627\u0644\u0622\u0646 \u064a\u0639\u064a\u062f \u0636\u0628\u0637 \u0627\u0644\u062a\u062d\u0643\u0645.","Doubter mode":"\u0648\u0636\u0639 \u0627\u0644\u0634\u0643","Doubter check \ud83d\ude3f":"\u0641\u062d\u0635 \u0634\u0643 \ud83d\ude3f","{{temptation}} usually wins now. Try sending {{amount}} to savings instead. \ud83e\uddf2":"{{temptation}} \u200b\u200b\u0639\u0627\u062f\u0629 \u0645\u0627 \u064a\u0641\u0648\u0632 \u0627\u0644\u0622\u0646. \u062d\u0627\u0648\u0644 \u0625\u0631\u0633\u0627\u0644 {{amount}} \u0625\u0644\u0649 \u0627\u0644\u062a\u0648\u0641\u064a\u0631 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0630\u0644\u0643. \ud83e\uddf2","Pick one \u201csave it\u201d thought and lock it in.":"\u0627\u062e\u062a\u0631 \u0641\u0643\u0631\u0629 \"\u0627\u062d\u0641\u0638\u0647\u0627\" \u0648\u0627\u062d\u0641\u0638\u0647\u0627.","Doubter mode is on-choose one confident move.":"\u0648\u0636\u0639 \u0627\u0644\u0634\u0643 \u0647\u0648 \u0627\u062e\u062a\u064a\u0627\u0631 \u062e\u0637\u0648\u0629 \u0648\u0627\u062d\u062f\u0629 \u0648\u0627\u062b\u0642\u0629.","Turn doubts into numbers, not purchases.":"\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0634\u0643\u0648\u0643 \u0625\u0644\u0649 \u0623\u0631\u0642\u0627\u0645\u060c \u0648\u0644\u064a\u0633 \u0645\u0634\u062a\u0631\u064a\u0627\u062a.","Doubts aside, goals still get reached. The course works.":"\u0648\u0628\u063a\u0636 \u0627\u0644\u0646\u0638\u0631 \u0639\u0646 \u0627\u0644\u0634\u0643\u0648\u0643\u060c \u0644\u0627 \u064a\u0632\u0627\u0644 \u064a\u062a\u0645 \u062a\u062d\u0642\u064a\u0642 \u0627\u0644\u0623\u0647\u062f\u0627\u0641. \u0627\u0644\u062f\u0648\u0631\u0629 \u062a\u0639\u0645\u0644.","Recharge mode":"\u0648\u0636\u0639 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0634\u062d\u0646","Feeling unsure? \ud83d\ude3f":"\u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0639\u062f\u0645 \u0627\u0644\u064a\u0642\u064a\u0646\u061f \ud83d\ude3f","\u201c{{title}}\u201d is stuck in limbo. Decide where it belongs. \ud83e\udde9":"\"{{title}}\" \u0639\u0627\u0644\u0642 \u0641\u064a \u0637\u064a \u0627\u0644\u0646\u0633\u064a\u0627\u0646. \u062a\u0642\u0631\u0631 \u0623\u064a\u0646 \u062a\u0646\u062a\u0645\u064a. \ud83e\udde9","That choice dissolves doubts.":"\u0648\u0647\u0630\u0627 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u064a\u0630\u064a\u0628 \u0627\u0644\u0634\u0643\u0648\u0643.","When {{temptation}} calls, redirect {{amount}} to savings to regain certainty. \ud83e\udded":"\u0639\u0646\u062f\u0645\u0627 \u064a\u062a\u0635\u0644 {{temptation}}\u060c \u0623\u0639\u062f \u062a\u0648\u062c\u064a\u0647 {{amount}} \u0625\u0644\u0649 \u0627\u0644\u0645\u062f\u062e\u0631\u0627\u062a \u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u064a\u0642\u064a\u0646. \ud83e\udded","There\u2019s the gentle restart. Nice.":"\u0647\u0646\u0627\u0643 \u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u0644\u0637\u064a\u0641\u0629. \u0644\u0637\u064a\u0641 - \u062c\u064a\u062f.","Gentle alert \ud83d\ude3d\ud83d\udca4":"\u062a\u0646\u0628\u064a\u0647 \u0644\u0637\u064a\u0641 \ud83d\ude3d\ud83d\udca4","Dreamer mode":"\u0648\u0636\u0639 \u0627\u0644\u062d\u0627\u0644\u0645","Start with one skip today and see the shift.":"\u0627\u0628\u0