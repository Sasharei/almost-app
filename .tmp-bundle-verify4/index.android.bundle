a\u0639\u0627\u062f\u062a\u0647\u0627.",coinValueTitle:"\u0644\u0645\u0627\u0630\u0627 \u062a\u0639\u062a\u0628\u0631 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0645\u0647\u0645\u0629\u061f",coinValueBody:"\u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u062f\u0646\u064a\u0629 \u0647\u064a \u0645\u0643\u0627\u0641\u0623\u0629 \u0644\u062c\u0647\u0648\u062f\u0643. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u064a\u0647\u0627 \u0641\u064a \u0623\u062f\u0627\u0629 \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0641\u064a \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0639\u0644\u0648\u064a \u0645\u0646 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629. \u062a\u0641\u062a\u062d \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u062f\u0646\u064a\u0629 \u0623\u064a\u0636\u064b\u0627 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u062a\u062e\u0635\u064a\u0635 Almi \u200b\u200b\u0648\u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u062e\u0637\u0648\u0637 \u0639\u0644\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a.",coinValueCta:"\u0641\u0647\u0645\u062a\u0647\u0627",impulseReminderWinTitle:"\u2705 \u0644\u0642\u062f \u062a\u063a\u0644\u0628\u062a \u0639\u0644\u0649 \"{{temptation}}\"",impulseReminderWinBody:"\u0644\u0642\u062f \u0623\u0646\u0642\u0630 \u0630\u0644\u0643 {{amount}} \u200b\u200b{{dayLabel}}. \u0627\u0633\u062a\u0645\u0631 \u0641\u064a \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062e\u0637 \u0627\u0644\u064a\u0648\u0645. \ud83d\udcaa",impulseReminderLoseTitle:"\ud83d\ude2c \u0641\u0627\u0632 \"{{temptation}}\" \u0628\u0640 {{dayLabel}}",impulseReminderLoseBody:"\u0627\u0644\u062a\u0643\u0644\u0641\u0629 {{amount}}. \u062e\u064a\u0627\u0631 \u0627\u0644\u064a\u0648\u0645 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a