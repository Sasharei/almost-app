a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644 \u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0648\u0627\u0644\u0645\u0644\u062e\u0635\u0627\u062a \u0627\u0644\u0645\u0633\u0627\u0626\u064a\u0629 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0648\u062a\u0638\u0647\u0631 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627.",featureUnlockThinkingPremiumDescription:"\u0627\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u0628\u0648\u064a\u0628 \"\u0627\u0644\u062a\u0641\u0643\u064a\u0631\" \u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0644\u0648\u0642\u062a \u0644\u0627\u062d\u0642\u061b \u064a\u062a\u0645 \u062a\u0634\u063a\u064a\u0644 \u0648\u0636\u0639 \u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0648\u0627\u0644\u0645\u0644\u062e\u0635\u0627\u062a \u0627\u0644\u0645\u0633\u0627\u0626\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627.",featureUnlockThinkingPreview:"\u0639\u0644\u0627\u0645\u0629 \u062a\u0628\u0648\u064a\u0628 \u0627\u0644\u062a\u0641\u0643\u064a\u0631",featureUnlockFreeDayTitle:"\u062e\u0637 \u064a\u0648\u0645 \u062d\u0631",featureUnlockFreeDayDescription:"\u064a\u062a\u062a\u0628\u0639 \u0633\u0644\u0633\u0644\u0629 \u0623\u064a\u0627\u0645 \u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0627\u0644\u0635\u0641\u0631\u064a \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643.",featureUnlockFreeDayPremiumDescription:"\u064a\u062a\u062a\u0628\u0639 \u0633\u0644\u0633\u0644\u0629 \u0623\u064a\u0627\u0645 \u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0627\u0644\u0635\u0641\u0631\u064a \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643.",impulseCardTitle:"\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u062f\u0627\u0641\u0639",impulseCardSubtitle:"\u062d\u064a\u062b \u0636\u0631\u0628\u062a \u0627\u0644\u0646\u0628\u0636\u0627\u062a \u0623\u0643\u062b\u0631.",impulseLoseLabel:"\u0636\u0639\u0641",impulseLoseCopy:"{{temptation}} \u200b\u200b\u064a\u0641\u0648\