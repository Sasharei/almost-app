sHint:"Earn coins via saves, levels, and rewards.",tamagotchiNeedCoinsMessage:"You need at least {{cost}} coins for {{emoji}}.",tamagotchiMissYouNotificationTitle:"Almi misses you \ud83d\ude3f",tamagotchiMissYouNotificationBody:"You have been away for over 20 hours. Almi feels sad and waits for you.",tamagotchiPartyNeedCoinsMessage:"You need {{amount}} blue coins to start a party.",tamagotchiPartyButtonLabel:"Party \xd7{{cost}}",tamagotchiImmunityHintTitle:"immunity",tamagotchiImmunityActiveLabel:"Hunger immunity is active",tamagotchiImmunityTimeLeftLabel:"Time left: {{time}}",tamagotchiFullHint:"He is full, try again later.",tamagotchiSpeechGreetingFirst:["Hi! I'm Almi.","Hey, you made it. I'm Almi.","Hi! Ready to save together?","Nice to meet you. I'm Almi.","Hey there! Let's start."],tamagotchiSpeechGreetingSoon:["Back again? Nice.","Already back? Love it.","You again! Good.","Quick return. I'm here.","Back after {{minutes}}m? Nice."],tamagotchiSpeechGreeting:["Welcome back!","Hey! Good to see you.","Hi again.","Glad you're here.","Back on track."],tamagotchiSpeechGreetingHungry:["Hi! I'm hungry, {{food}}?","You're back! Can I have {{food}}?","I missed you and I'm hungry. {{food}}?","Welcome back. Feed me {{food}}?","Hey! Snack time? {{food}}?"],tamagotchiSpeechMissed:["Missed you. Glad you're back.","There you are. Missed you.","You're back. Nice.","I was waiting.","Welcome back."],tamagotchiSpeechMissedHungry:["Missed you and I'm hungry. {{food}}?","Where were you? I'm hungry.","I waited. I'm hungry.","Missed you. Feed me?"],tamagotchiSpeechHungry:["I'm hungry. {{food}}?","Belly rumbling. Snack?","I want {{food}}.","Feed me?"],tamagotchiSpeechHungrySoft:["A little hungry.","Can I snack?","I could use a bite.","{{food}} would be nice."],tamagotchiSpeechFed:["Purr, tasty!","Thanks for the {{food}}!","Fullness +1. Meow.","That hit the spot.","Mrr, thanks!"],tamagotchiSpeechNeedPlay:["I'm bored. Can we play {{toy}}?","I want to play. Let's go with {{toy}}!","I'm sad without games. Bring {{toy}}?","Play with me? I'm waiting for {{toy}}."],tamagotchiSpeechNeedClean:["I'm dirty. Bath time, please.","Can you clean me up? I'm dusty.","I need soap and a brush.","Please clean my fur."],tamagotchiSpeechPlayed:["{{toy}} was awesome!","Thanks for playing with me!","That was fun. Let's do it again later.","Purr! Playing made my day."],tamagotchiSpeechCleaned:["Thanks, I'm clean and fluffy again!","Mrr, that felt so good.","My fur shines now. Thank you!","Best grooming ever. Thanks!"],tamagotchiSpeechPraiseSaveYesterday:["You skipped \u201c{{title}}\u201d yesterday.","Yesterday's win: \u201c{{title}}\u201d.","Nice one with \u201c{{title}}\u201d."],tamagotchiSpeechPraiseSaveRecent:["Great save: \u201c{{title}}\u201d.","Nice! \u201c{{title}}\u201d skipped.","Win: \u201c{{title}}\u201d."],tamagotchiSpeechSaveWin:["Win! Great save.","Another victory!","Nice hold. You did it.","Solid call.","Big win."],tamagotchiSpeechTrollSpendYesterday1:"Yesterday: \u201c{{title}}\u201d. I saw it.",tamagotchiSpeechTrollSpendYesterday2:"You caved on \u201c{{title}}\u201d yesterday.",tamagotchiSpeechTrollSpendYesterday3:"Yesterday\u2019s \u201c{{title}}\u201d. Noted.",tamagotchiSpeechTrollSpendRecent1:"Another \u201c{{title}}\u201d. I saw.",tamagotchiSpeechTrollSpendRecent2:"\u201c{{title}}\u201d again. I see.",tamagotchiSpeechTrollSpendRecent3:"\u201c{{title}}\u201d again? I noticed.",tamagotchiSpeechSpendRegret:["Oof, \u201c{{title}}\u201d happened. We move on.","\u201c{{title}}\u201d got you this time. Next win soon.","It happens. \u201c{{title}}\u201d won't break the streak.","Okay, \u201c{{title}}\u201d - next choice is ours.","Noted: \u201c{{title}}\u201d. We'll bounce back."],tamagotchiSpeechSpendRegretGeneric:["It happens. Next choice counts.","No blame. Keep going.","Okay. We'll bounce back.","Not ideal, but we continue.","I'm here. Onward."],tamagotchiSpeechGoalComplete:["Goal complete! What's next?","You nailed it. New dream?","Done! New target?"],