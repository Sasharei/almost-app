    "expenseWalletInputRequired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يرسل Wallet المبلغ والعملة. أضف أتمتة Almost Apple Pay الجاهزة مجددًا؛ لا تُدخل تفاصيل الدفع يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet hat keinen Betrag und keine Währung übermittelt. Füge die fertige Automation Almost Apple Pay erneut hinzu; gib Zahlungsdaten nicht manuell ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet did not provide an amount and currency. Add the ready Almost Apple Pay automation again; do not enter payment details manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet no proporcionó el importe y la moneda. Vuelve a añadir la automatización preparada Almost Apple Pay; no introduzcas los datos del pago manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet n’a pas fourni le montant et la devise. Ajoutez à nouveau l’automatisation prête à l’emploi Almost Apple Pay ; ne saisissez pas les détails du paiement manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet non ha fornito importo e valuta. Aggiungi di nuovo l’automazione pronta Almost Apple Pay; non inserire i dati del pagamento manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet から金額と通貨が渡されませんでした。設定済みの Almost Apple Pay オートメーションを再追加してください。支払い情報を手入力しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet에서 금액과 통화를 전달하지 않았습니다. 준비된 Almost Apple Pay 자동화를 다시 추가하세요. 결제 정보를 직접 입력하지 마세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Wallet não forneceu o valor e a moeda. Adicione novamente a automação pronta Almost Apple Pay; não insira os dados do pagamento manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet не передал сумму и валюту. Добавьте готовую автоматизацию Almost Apple Pay заново; не вводите данные платежа вручную."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet 未提供金额和币种。请重新添加准备好的 Almost Apple Pay 自动化；不要手动输入付款信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet 未提供金額和幣別。請重新加入準備好的 Almost Apple Pay 自動化；不要手動輸入付款資料。"
          }
        }
      }
    },
    "expenseWalletIntentDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل المبلغ والعملة الواردين من أتمتة معاملات Wallet على الجهاز. فعّل الاستيراد في Almost أولًا. التاجر والتاريخ اختياريان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert Betrag und Währung aus einer Wallet-Transaktionsautomation lokal. Aktiviere zuerst den Import in Almost. Händler und Datum sind optional."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record the amount and currency supplied by a Wallet Transaction automation locally. Enable import in Almost first. Merchant and date are optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra localmente el importe y la moneda de una automatización de transacciones de Wallet. Activa primero la importación en Almost. Comercio y fecha son opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre localement le montant et la devise fournis par une automatisation de transactions Wallet. Activez d’abord l’importation dans Almost. Le commerçant et la date sont facultatifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra sul dispositivo importo e valuta forniti da un’automazione delle transazioni Wallet. Attiva prima l’importazione in Almost. Esercente e data sono facoltativi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet の取引オートメーションから受け取った金額と通貨をデバイスに記録します。先に Almost で読み込みを有効にしてください。店舗と日付は任意です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet 거래 자동화가 제공하는 금액과 통화를 기기에 기록합니다. 먼저 Almost에서 가져오기를 켜세요. 가맹점과 날짜는 선택 사항입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra no dispositivo o valor e a moeda fornecidos por uma automação de transações do Wallet. Ative a importação no Almost primeiro. Estabelecimento e data são opcionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает на устройстве сумму и валюту из автоматизации транзакций Wallet. Сначала включите импорт в Almost. Продавец и дата необязательны."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上记录 Wallet 交易自动化提供的金额和货币。请先在 Almost 中启用导入。商家和日期为可选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在裝置上記錄 Wallet 交易自動化提供的金額和貨幣。請先在 Almost 中啟用匯入。商家和日期為選填。"
          }
        }
      }
    },
