{
  "sourceLanguage": "en",
  "strings": {
    "expenseDisabled": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل استيراد المصروفات في Almost أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere zuerst den Ausgabenimport in Almost."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable expense import in Almost first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa primero la importación de gastos en Almost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d’abord l’importation des dépenses dans Almost."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva prima l’importazione delle spese in Almost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に Almost で支出の読み込みを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Almost에서 지출 가져오기를 켜세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative primeiro a importação de despesas no Almost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала включите импорт расходов в Almost."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 Almost 启用支出导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 Almost 啟用支出匯入。"
          }
        }
      }
    },
    "expenseError": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحميل أو الحفظ. حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden oder Speichern fehlgeschlagen. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load or save. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar o guardar. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement ou enregistrement impossible. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare o salvare. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みまたは保存ができませんでした。再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불러오거나 저장하지 못했습니다. 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar ou guardar. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить или сохранить. Повторите попытку."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载或保存，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入或儲存，請重試。"
          }
        }
      }
    },
    "expensePremiumRequired": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الاستيراد التلقائي بريميوم. تبقى نفقاتك المحفوظة متاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der automatische Import erfordert Premium. Gespeicherte Ausgaben bleiben verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic import requires Premium. Your saved expenses remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación automática requiere Premium. Tus gastos guardados siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation automatique nécessite Premium. Vos dépenses enregistrées restent accessibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importazione automatica richiede Premium. Le spese salvate restano disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動取り込みにはプレミアムが必要です。保存済みの支出は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 가져오기는 프리미엄이 필요합니다. 저장된 지출은 계속 이용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação automática requer Premium. As despesas guardadas continuam disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматический импорт доступен с Premium. Сохранённые расходы остаются доступны."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "自动导入需要高级版。已保存的支出仍可查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動匯入需要進階版。已儲存的支出仍可查看。"
          }
        }
      }
    },
