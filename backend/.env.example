PORT=8787
NODE_ENV=development
STRICT_STARTUP_VALIDATION=1
HEALTH_EXPOSE_DETAILS=0
ENFORCE_INSTALL_ID_BINDING=1
REQUIRE_INSTALL_SECRET_PROOF=1
ALLOW_LEGACY_INSTALL_SECRET_GRACE=0
INSTALL_SECRET_MIN_LENGTH=32
RATE_LIMIT_AUTH_SESSION_PER_MINUTE=120
RATE_LIMIT_APP_PER_MINUTE=600
RISK_INSTALL_WINDOW_MAX_ENTRIES=20000

# Legacy development-only fallback. Production requires the session secret.
APP_SHARED_SECRET=
# Generate 32 random bytes locally; never EXPO_PUBLIC.
APP_SESSION_SECRET=
APP_SESSION_TTL_MS=300000
REQUEST_TTL_MS=900000
STORE_PATH=
STORE_DATABASE_PATH=./data/entitlements.sqlite
# Empty means no proxy is trusted. List exact ingress CIDRs when required.
TRUSTED_PROXY_CIDRS=
# Read-only subscriber lookup used for RevenueCat ownership and restore proof.
REVENUECAT_API_KEY=
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
PREMIUM_PRODUCT_IDS=almost_premium_weekly,almost_premium_monthly,almost_premium_yearly,almost_premium_lifetime

# Webhooks fail closed without authentication. Secrets are header-only.
WEBHOOK_SHARED_SECRET=

# Apple validation
# When APPLE_VALIDATION_ENABLED=1, the following are required:
# APPLE_BUNDLE_ID, APPLE_ISSUER_ID, APPLE_KEY_ID, APPLE_PRIVATE_KEY
APPLE_VALIDATION_ENABLED=0
APPLE_ENVIRONMENT=sandbox
APPLE_BUNDLE_ID=com.sasarei.almostclean
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_APPLE_ID=

# Apple server notifications webhook
APPLE_WEBHOOK_SECRET=
APPLE_WEBHOOK_VERIFY_SIGNATURE=0
APPLE_WEBHOOK_REQUIRE_VERIFIED=0
APPLE_WEBHOOK_ONLINE_CHECKS=0
# Comma-separated file paths to Apple Root CA certificates (DER .cer files)
APPLE_ROOT_CA_PATHS=./certs/AppleRootCA-G3.cer,./certs/AppleRootCA-G2.cer

# Google Play validation
# When GOOGLE_VALIDATION_ENABLED=1, the following are required:
# GOOGLE_PACKAGE_NAME, GOOGLE_SERVICE_ACCOUNT_JSON
GOOGLE_VALIDATION_ENABLED=0
GOOGLE_PACKAGE_NAME=com.sasarei.almostclean
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google RTDN webhook
GOOGLE_RTDN_SECRET=
# For direct Pub/Sub delivery use authenticated push instead of custom headers.
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=
